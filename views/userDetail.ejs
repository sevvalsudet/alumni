<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head', { title: user.name + ' • Member Profile' }) %>
    <style>
        .profile-container {
            max-width: 1100px;
            margin: 0 auto;
        }
        .profile-hero {
            display: flex;
            align-items: center;
            gap: 24px;
            margin-bottom: 28px;
            padding-bottom: 24px;
            border-bottom: 1px solid var(--hairline-soft);
        }
        .avatar {
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, #1d1d1f, #3a3a3c);
            color: #ffffff;
            border-radius: var(--radius-lg);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 32px;
            font-weight: 700;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
            flex-shrink: 0;
        }
        .profile-details-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
            margin-bottom: 28px;
        }
        .info-cell {
            background: var(--canvas-parchment);
            border: 1px solid rgba(0, 0, 0, 0.05);
            border-radius: var(--radius-md);
            padding: 16px 20px;
        }
        .info-cell-label {
            font-size: 12px;
            font-weight: 600;
            color: var(--ink-muted);
            text-transform: uppercase;
            letter-spacing: 0.06em;
            margin-bottom: 4px;
        }
        .info-cell-value {
            font-size: 16px;
            font-weight: 600;
            color: var(--ink);
        }
        @media (max-width: 640px) {
            .profile-details-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <%- include('partials/navbar', { active: 'users' }) %>

    <main class="container">
        <div class="profile-container">
            <% if (typeof welcome !== 'undefined' && welcome) { %>
                <div style="background: rgba(52, 199, 89, 0.1); border: 1px solid rgba(52, 199, 89, 0.25); color: #248a3d; padding: 14px 20px; border-radius: 18px; margin-bottom: 20px; display: flex; align-items: center; gap: 10px; font-size: 14.5px;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                    <span><strong>Welcome to Alumni Network!</strong> Your verified profile has been successfully created and registered.</span>
                </div>
            <% } %>

            <div style="margin: 20px 0 16px;">
                <a href="/users" class="link-chevron" style="font-weight: 600;">← Back to Members Directory</a>
            </div>

            <div class="card">
                <div class="profile-hero">
                    <div class="avatar"><%= user.name ? user.name.charAt(0).toUpperCase() : 'U' %></div>
                    <div style="flex: 1;">
                        <h1 style="font-size: 28px; font-weight: 700; color: var(--ink); margin-bottom: 6px; letter-spacing: -0.02em;"><%= user.name %></h1>
                        <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
                            <span class="badge <%= user.role === 'Student' ? 'badge-role-student' : 'badge-role-alumni' %>">
                                <%= user.role === 'Student' ? 'Student' : 'Alumni' %>
                            </span>
                            <span style="font-size: 13px; color: var(--ink-muted); font-family: monospace;">ID: #<%= user.id %></span>
                            <% if (user.email) { %>
                                <span style="font-size: 13px; color: var(--ink-secondary);">&bull; <%= user.email %></span>
                            <% } %>
                        </div>
                    </div>
                </div>

                <div class="profile-details-grid">
                    <div class="info-cell">
                        <div class="info-cell-label">Member ID</div>
                        <div class="info-cell-value">#<%= user.id %></div>
                    </div>
                    <div class="info-cell">
                        <div class="info-cell-label">System Role</div>
                        <div class="info-cell-value"><%= user.role %></div>
                    </div>
                    <div class="info-cell">
                        <div class="info-cell-label">Department / Major</div>
                        <div class="info-cell-value"><%= user.department || '—' %></div>
                    </div>
                    <div class="info-cell">
                        <div class="info-cell-label">Company / Organization</div>
                        <div class="info-cell-value"><%= user.company || '—' %></div>
                    </div>
                    <div class="info-cell">
                        <div class="info-cell-label">Graduation Year</div>
                        <div class="info-cell-value"><%= user.graduation_year || '—' %></div>
                    </div>
                    <div class="info-cell">
                        <div class="info-cell-label">Contact Phone</div>
                        <div class="info-cell-value"><%= user.phone || '—' %></div>
                    </div>
                </div>

                <% if (user.bio) { %>
                    <div style="margin-bottom: 24px; padding: 18px 20px; background: rgba(0,0,0,0.02); border-radius: 16px; border: 1px solid rgba(0,0,0,0.04);">
                        <div style="font-size: 11.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--ink-muted); margin-bottom: 6px;">Biography &amp; Professional Focus</div>
                        <div style="font-size: 14.5px; color: var(--ink); line-height: 1.6;"><%= user.bio %></div>
                    </div>
                <% } %>

                <% if (user.linkedin_url || user.github_url) { %>
                    <div style="display: flex; gap: 12px; margin-bottom: 24px; flex-wrap: wrap;">
                        <% if (user.linkedin_url) { %>
                            <a href="<%= user.linkedin_url %>" target="_blank" class="action-pill action-view" style="font-size: 13px; padding: 6px 16px;">
                                LinkedIn Profile ↗
                            </a>
                        <% } %>
                        <% if (user.github_url) { %>
                            <a href="<%= user.github_url %>" target="_blank" class="action-pill action-edit" style="font-size: 13px; padding: 6px 16px;">
                                GitHub / Portfolio ↗
                            </a>
                        <% } %>
                    </div>
                <% } %>

                <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; margin-bottom: 24px;">
                    <a href="/users/<%= user.id %>/jobs" class="btn btn-outline" style="font-size: 13.5px; padding: 12px 18px; text-align: center; justify-content: center;">
                        Posted Jobs & Opportunities
                    </a>
                    <a href="/users/<%= user.id %>/applications" class="btn btn-outline" style="font-size: 13.5px; padding: 12px 18px; text-align: center; justify-content: center;">
                        Submitted Applications Pipeline
                    </a>
                </div>

                <div style="display: flex; gap: 12px; border-top: 1px solid var(--hairline-soft); padding-top: 20px;">
                    <a href="/users/<%= user.id %>/edit" class="btn btn-runway" style="flex: 2;">
                        Edit Profile
                    </a>
                    <form action="/users/<%= user.id %>/delete" method="POST" style="flex: 1;" onsubmit="return confirm('Are you sure you want to delete this member profile?');">
                        <button type="submit" class="btn btn-danger" style="width: 100%;">Delete Member</button>
                    </form>
                </div>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
