<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head', { title: '500 • Internal Server Error • Alumni.io' }) %>
    <style>
        .error-card {
            max-width: 680px;
            margin: 48px auto;
            text-align: center;
            padding: 48px 32px;
        }
        .error-icon {
            width: 72px;
            height: 72px;
            margin: 0 auto 20px;
            background: var(--status-red-bg);
            border: 1px solid rgba(255, 59, 48, 0.2);
            border-radius: var(--radius-lg);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 32px;
        }
        .error-pill {
            display: inline-block;
            background: var(--status-red-bg);
            border: 1px solid rgba(255, 59, 48, 0.2);
            padding: 8px 16px;
            border-radius: var(--radius-pill);
            font-family: monospace;
            font-size: 13px;
            color: var(--status-red);
            margin: 18px 0 28px;
            max-width: 100%;
            word-break: break-all;
        }
    </style>
</head>
<body>
    <%- include('partials/navbar') %>

    <main class="container">
        <div class="card error-card">
            <div class="error-icon">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--status-red)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
            </div>
            <h1 style="font-size: 28px; font-weight: 700; color: var(--status-red); margin-bottom: 8px; letter-spacing: -0.02em;">
                500 • Internal Server Error
            </h1>
            <p style="color: var(--ink-secondary); font-size: 15px; line-height: 1.6;">
                An unexpected condition was encountered while processing your request.<br>
                <strong>5xx Guardian Middleware</strong> captured this exception, logged it safely to <code>logs/error.logs</code>, and prevented server disruption.
            </p>

            <div class="error-pill">
                [<%= typeof method !== 'undefined' ? method : 'GET' %>] <%= typeof url !== 'undefined' ? url : '' %> &bull; <%= typeof errorMessage !== 'undefined' ? errorMessage : "Internal Server Error" %>
            </div>

            <div style="display: flex; justify-content: center; gap: 12px; flex-wrap: wrap;">
                <a href="/" class="btn btn-runway">Back to Homepage</a>
                <a href="javascript:location.reload()" class="btn btn-secondary">Retry Request</a>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
