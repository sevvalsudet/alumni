<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head', { title: 'Alumni Tracking System • Apple & RunwayML Edition' }) %>
    <style>
        /* Hero: Apple Museum Scale & Runway Editorial Pacing */
        .hero-section {
            text-align: center;
            padding: 70px 0 38px;
        }

        .hero-eyebrow {
            font-size: 13px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--ink-muted);
            margin-bottom: 12px;
            display: inline-block;
        }

        .hero-title {
            font-size: clamp(38px, 5.5vw, 62px);
            font-weight: 700;
            letter-spacing: -0.04em;
            line-height: 1.06;
            color: var(--ink-pure);
            margin-bottom: 18px;
        }

        .hero-desc {
            font-size: 18.5px;
            color: var(--ink-secondary);
            max-width: 720px;
            margin: 0 auto 30px;
            line-height: 1.55;
            font-weight: 400;
            letter-spacing: -0.015em;
        }

        .hero-buttons {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 16px;
            flex-wrap: wrap;
            margin-bottom: 34px;
        }

        /* Two-Column Overview Grid: Network Connection + Partner Companies */
        .overview-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 28px;
            max-width: 1280px;
            margin: 0 auto 56px;
            padding: 0 32px;
            align-items: stretch;
        }

        .overview-card {
            background: #f0f0f0;
            border: 1px solid rgba(0, 0, 0, 0.1);
            border-radius: 0;
            padding: 22px 24px 18px;
            box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            min-height: 220px;
            transition: all 0.25s ease;
        }

        .overview-card:hover {
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
            border-color: rgba(0, 0, 0, 0.2);
        }

        .overview-card-header {
            margin-bottom: 12px;
            text-align: center;
        }

        .overview-card-header h3 {
            font-size: 17px;
            font-weight: 700;
            letter-spacing: -0.025em;
            color: var(--ink);
            margin-bottom: 4px;
            text-align: center;
        }

        .overview-card-header p {
            font-size: 12.5px;
            color: var(--ink-secondary);
            line-height: 1.45;
            margin: 0;
            text-align: center;
        }

        /* Flowing Looping Swirl Dotted SVG */
        .network-svg-container {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex: 1;
            padding: 4px 0;
        }

        .network-dots-svg {
            width: 100%;
            max-width: 420px;
            height: auto;
            display: block;
        }

        @keyframes flowDash {
            0% { stroke-dashoffset: 27; }
            100% { stroke-dashoffset: 0; }
        }

        .flow-curved-arrow {
            stroke: #1d1d1f;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-dasharray: 4 5;
            animation: flowDash 2.4s linear infinite;
        }

        /* Colored Partner Logos Grid */
        .company-logos-card-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
            align-items: center;
            justify-items: center;
            flex: 1;
            padding: 6px 0 0;
        }

        .company-logo-item {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            color: #1d1d1f;
            font-size: 13px;
            font-weight: 600;
            letter-spacing: -0.015em;
            transition: all 0.2s ease;
            text-decoration: none;
            padding: 8px 10px;
            border-radius: 0;
            background: #ffffff;
            border: 1px solid rgba(0, 0, 0, 0.08);
            width: 100%;
            height: 38px;
            box-sizing: border-box;
            justify-content: flex-start;
        }

        .company-logo-item:hover {
            border-color: #1d1d1f;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
            transform: translateY(-1px);
        }

        .company-logo-item svg {
            flex-shrink: 0;
        }

        @media (max-width: 900px) {
            .overview-grid {
                grid-template-columns: 1fr;
                padding: 0 16px;
            }
        }

        /* 3. VISUAL: Smooth Auto-Scrolling Alumni Spotlight Cards */
        .spotlight-section {
            margin-bottom: 75px;
            overflow: hidden;
        }

        .spotlight-header-row {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            margin-bottom: 24px;
            flex-wrap: wrap;
            gap: 16px;
        }

        .spotlight-header-row h2 {
            font-size: 28px;
            font-weight: 700;
            letter-spacing: -0.03em;
            color: var(--ink);
            margin-bottom: 6px;
        }

        .spotlight-header-row p {
            font-size: 15px;
            color: var(--ink-secondary);
        }

        .spotlight-marquee-container {
            width: 100%;
            overflow: hidden;
            position: relative;
            padding: 10px 0 20px;
            mask-image: linear-gradient(to right, transparent, black 3%, black 97%, transparent);
            -webkit-mask-image: linear-gradient(to right, transparent, black 3%, black 97%, transparent);
        }

        .spotlight-track {
            display: flex;
            gap: 20px;
            width: max-content;
            animation: marqueeScroll 45s linear infinite;
        }

        .spotlight-track:hover {
            animation-play-state: paused;
        }

        @keyframes marqueeScroll {
            0% { transform: translateX(0); }
            100% { transform: translateX(calc(-50% - 10px)); }
        }

        .spotlight-card {
            flex: 0 0 320px;
            width: 320px;
            background: #ffffff;
            border: 1px solid rgba(0, 0, 0, 0.06);
            border-radius: var(--radius-lg);
            padding: 26px 22px;
            box-shadow: var(--shadow-apple);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: all 0.25s ease;
        }

        .spotlight-card:hover {
            transform: translateY(-3px);
            box-shadow: var(--shadow-hover);
        }

        .spotlight-top {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-bottom: 16px;
        }

        .spotlight-avatar {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 16px;
            color: #ffffff;
            flex-shrink: 0;
        }

        .avatar-1 { background: linear-gradient(135deg, #0071e3, #47a3ff); }
        .avatar-2 { background: linear-gradient(135deg, #1d1d1f, #48484a); }
        .avatar-3 { background: linear-gradient(135deg, #f56300, #ff8c38); }
        .avatar-4 { background: linear-gradient(135deg, #34c759, #30d158); }
        .avatar-5 { background: linear-gradient(135deg, #af52de, #bf5af2); }

        .spotlight-name {
            font-size: 16.5px;
            font-weight: 700;
            color: var(--ink);
            letter-spacing: -0.02em;
        }

        .spotlight-role {
            font-size: 13px;
            color: var(--apple-blue);
            font-weight: 500;
        }

        .spotlight-meta-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: var(--canvas-parchment);
            padding: 4px 10px;
            border-radius: var(--radius-pill);
            font-size: 12px;
            color: var(--ink-secondary);
            margin-bottom: 14px;
            border: 1px solid rgba(0, 0, 0, 0.04);
        }

        .spotlight-quote {
            font-size: 14px;
            color: var(--ink-secondary);
            line-height: 1.55;
            font-style: italic;
            margin-bottom: 20px;
        }

        .spotlight-action {
            margin-top: auto;
            border-top: 1px solid var(--hairline-soft);
            padding-top: 14px;
        }

        /* Product Modules Grid */
        .tiles-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 22px;
            margin-bottom: 65px;
        }

        .tile-card {
            background: var(--canvas-card);
            border: 1px solid rgba(0, 0, 0, 0.06);
            border-radius: var(--radius-lg);
            padding: 34px 30px;
            text-decoration: none;
            color: inherit;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            box-shadow: var(--shadow-apple);
            transition: all 0.25s ease;
        }

        .tile-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-hover);
        }

        .tile-eyebrow {
            font-size: 11.5px;
            font-weight: 700;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            margin-bottom: 12px;
            display: block;
        }

        .tile-title {
            font-size: 21px;
            font-weight: 700;
            letter-spacing: -0.02em;
            color: var(--ink);
            margin-bottom: 10px;
            line-height: 1.25;
        }

        .tile-desc {
            font-size: 14.5px;
            color: var(--ink-secondary);
            line-height: 1.55;
            margin-bottom: 24px;
        }

        .tile-wide {
            grid-column: span 2;
        }

        /* Apple Dark Feature Showcase Tile */
        .apple-dark-tile {
            background: var(--canvas-tile-dark);
            border-radius: var(--radius-lg);
            padding: 24px 32px;
            color: white;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 24px;
            margin-bottom: 50px;
        }

        .dark-tile-title {
            font-size: 18px;
            font-weight: 700;
            letter-spacing: -0.025em;
            margin-bottom: 4px;
        }

        .dark-tile-desc {
            font-size: 13px;
            color: #86868b;
            max-width: 620px;
            line-height: 1.5;
        }

        @media (max-width: 900px) {
            .tiles-grid { grid-template-columns: repeat(2, 1fr); }
            .tile-wide { grid-column: span 2; }
            .apple-dark-tile { flex-direction: column; align-items: flex-start; }
        }

        @media (max-width: 640px) {
            .tiles-grid { grid-template-columns: 1fr; }
            .tile-wide { grid-column: span 1; }
            .hero-title { font-size: 36px; }
            .hero-desc { font-size: 17px; }
        }
    </style>
</head>
<body>
    <%- include('partials/navbar') %>

    <main class="container">
        <!-- Hero Section -->
        <section class="hero-section">
            <span class="hero-eyebrow">Alumni & Career Ecosystem</span>
            <h1 class="hero-title">From Graduation to Career.</h1>
            <p class="hero-desc">
                Connecting university alumni and students to build lifelong professional relationships, 
                share verified career opportunities, and empower the next generation of leaders.
            </p>
            <div class="hero-buttons">
                <a href="/jobs" class="btn btn-runway" style="padding: 13px 30px; font-size: 15.5px;">
                    Explore Job Postings
                </a>
                <a href="/users" class="btn btn-outline" style="padding: 13px 28px; font-size: 15.5px;">
                    Discover Alumni Network ›
                </a>
            </div>
        </section>

        <!-- Two-Column Overview Grid: Looping Swirl Flow Diagram (Left) & Partner Companies (Right) -->
        <section class="overview-grid">
            <!-- Left Box: Dotted Looping Swirl Diagram (Alumni, Students, Companies) -->
            <div class="overview-card">
                <div class="overview-card-header">
                    <h3>Connecting Every Graduation Journey</h3>
                    <p>A continuous lifecycle uniting students, mentors, and employers.</p>
                </div>

                <div class="network-svg-container">
                    <svg class="network-dots-svg" viewBox="0 0 380 200" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <defs>
                            <marker id="arrowHead" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                                <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="#1d1d1f"/>
                            </marker>
                        </defs>

                        <!-- 1. LEFT BRANCH: From Alumni (190, 36) -> Students (75, 145) with looping swirl -->
                        <path d="M 166 42 C 125 45, 90 62, 90 84 C 90 99, 122 101, 118 84 C 114 66, 78 92, 75 120"
                              class="flow-curved-arrow" marker-end="url(#arrowHead)"/>

                        <!-- 2. RIGHT BRANCH: From Alumni (190, 36) -> Companies (305, 145) with looping swirl -->
                        <path d="M 214 42 C 255 45, 290 62, 290 84 C 290 99, 258 101, 262 84 C 266 66, 302 92, 305 120"
                              class="flow-curved-arrow" marker-end="url(#arrowHead)"/>

                        <!-- 3. BOTTOM BRANCH: From Students (75, 145) -> Companies (305, 145) with dotted trail & dot cluster -->
                        <path d="M 104 156 Q 190 178, 276 156"
                              class="flow-curved-arrow" marker-end="url(#arrowHead)"/>

                        <!-- Swirling Dot Constellation in Center of Bottom Path (as drawn in sketch) -->
                        <g class="swirl-dots-cluster">
                            <circle cx="190" cy="158" r="3" fill="#1d1d1f"/>
                            <circle cx="178" cy="154" r="2.2" fill="#86868b"/>
                            <circle cx="202" cy="154" r="2.2" fill="#86868b"/>
                            <circle cx="174" cy="165" r="1.8" fill="#a1a1a6"/>
                            <circle cx="206" cy="165" r="1.8" fill="#a1a1a6"/>
                            <circle cx="186" cy="172" r="2" fill="#86868b"/>
                            <circle cx="196" cy="172" r="2" fill="#86868b"/>
                            <circle cx="190" cy="178" r="1.5" fill="#a1a1a6"/>
                            <circle cx="166" cy="158" r="1.6" fill="#c7c7cc"/>
                            <circle cx="214" cy="158" r="1.6" fill="#c7c7cc"/>
                        </g>

                        <!-- Node 1: Alumni (Top Center) -->
                        <g transform="translate(190, 36)">
                            <circle r="18" fill="#ffffff" stroke="#1d1d1f" stroke-width="1.8"/>
                            <!-- Star / Mentor Icon -->
                            <path d="M 0 -6 L 1.8 -1.8 L 6.2 -1.8 L 2.6 1 L 4 5.5 L 0 2.8 L -4 5.5 L -2.6 1 L -6.2 -1.8 L -1.8 -1.8 Z" fill="#1d1d1f"/>
                            <text y="-25" text-anchor="middle" font-size="12" font-weight="700" fill="#1d1d1f" font-family="-apple-system, sans-serif">Alumni</text>
                            <text y="-14" text-anchor="middle" font-size="9" fill="#86868b" font-family="-apple-system, sans-serif">Mentors & Leaders</text>
                        </g>

                        <!-- Node 2: Students (Bottom Left) -->
                        <g transform="translate(75, 145)">
                            <circle r="18" fill="#ffffff" stroke="#1d1d1f" stroke-width="1.8"/>
                            <!-- Student Mortarboard Icon -->
                            <path d="M -7 -1 L 0 -5 L 7 -1 L 0 3 Z" fill="#1d1d1f"/>
                            <path d="M -4 1.5 L -4 4.5 C -4 6, 4 6, 4 4.5 L 4 1.5" fill="none" stroke="#1d1d1f" stroke-width="1.2"/>
                            <path d="M 7 -1 L 7 4" stroke="#1d1d1f" stroke-width="1.2"/>
                            <text y="28" text-anchor="middle" font-size="12" font-weight="700" fill="#1d1d1f" font-family="-apple-system, sans-serif">Students</text>
                            <text y="39" text-anchor="middle" font-size="9" fill="#86868b" font-family="-apple-system, sans-serif">Active Talent</text>
                        </g>

                        <!-- Node 3: Companies (Bottom Right) -->
                        <g transform="translate(305, 145)">
                            <circle r="18" fill="#ffffff" stroke="#1d1d1f" stroke-width="1.8"/>
                            <!-- Enterprise Building Icon -->
                            <path d="M -6 6 L -6 -6 L 1 -6 L 1 6 Z" fill="none" stroke="#1d1d1f" stroke-width="1.3"/>
                            <path d="M 1 6 L 1 -2 L 6 -2 L 6 6 Z" fill="none" stroke="#1d1d1f" stroke-width="1.3"/>
                            <line x1="-3.5" y1="-3" x2="-1.5" y2="-3" stroke="#1d1d1f" stroke-width="1"/>
                            <line x1="-3.5" y1="0" x2="-1.5" y2="0" stroke="#1d1d1f" stroke-width="1"/>
                            <text y="28" text-anchor="middle" font-size="12" font-weight="700" fill="#1d1d1f" font-family="-apple-system, sans-serif">Companies</text>
                            <text y="39" text-anchor="middle" font-size="9" fill="#86868b" font-family="-apple-system, sans-serif">Hiring Partners</text>
                        </g>
                    </svg>
                </div>
            </div>

            <!-- Right Box: Where Our Graduates Work & Hire -->
            <div class="overview-card">
                <div class="overview-card-header">
                    <h3>Where Our Graduates Work & Hire</h3>
                    <p>Alumni leading teams across top global technology organizations.</p>
                </div>

                <div class="company-logos-card-grid">
                    <!-- 1. Google -->
                    <a href="https://about.google" target="_blank" class="company-logo-item" title="Google">
                        <svg viewBox="0 0 24 24" width="16" height="16">
                            <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.66-5.17 3.66-9.17z"/>
                            <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.15C3.26 21.36 7.33 24 12 24z"/>
                            <path fill="#FBBC05" d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.14-1.55.38-2.27V6.58H1.25C.45 8.18 0 10.04 0 12s.45 3.82 1.25 5.42l4.03-3.15z"/>
                            <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.33 0 3.26 2.64 1.25 6.58l4.03 3.15c.95-2.83 3.6-4.98 6.72-4.98z"/>
                        </svg>
                        <span>Google</span>
                    </a>

                    <!-- 2. Apple -->
                    <a href="https://www.apple.com" target="_blank" class="company-logo-item" title="Apple">
                        <svg viewBox="0 0 170 170" width="15" height="15" fill="#000000">
                            <path d="M150.37 130.25c-2.45 5.66-5.35 10.87-8.71 15.66-4.58 6.53-8.33 11.05-11.22 13.56-4.48 4.12-9.28 6.23-14.42 6.35-3.69 0-8.14-1.05-13.32-3.18-5.19-2.12-9.97-3.17-14.34-3.17-4.58 0-9.49 1.05-14.75 3.17-5.26 2.13-9.5 3.24-12.74 3.35-4.35.13-9.16-1.9-14.42-6.08-3.7-3.04-7.58-7.7-11.64-13.98-5.74-8.8-10.37-18.73-13.88-28.79-3.52-10.06-5.28-20.08-5.28-30.07 0-11.07 2.6-20.73 7.8-28.98 5.2-8.25 12.05-14.65 20.55-19.2 8.5-4.55 17.65-6.88 27.46-6.98 5.11 0 10.87 1.34 17.27 4.02 6.4 2.68 10.12 4.02 11.16 4.02 1.05 0 5.12-1.45 12.22-4.35 7.1-2.9 13.43-4.14 18.99-3.72 14.07.64 25.13 5.43 33.18 14.38-12.27 7.42-18.3 17.48-18.1 30.19.2 9.87 3.86 18.17 10.99 24.89 7.13 6.72 15.7 10.66 25.71 11.83-2.67 8.16-5.87 16.54-9.61 25.14zM119.22 31.84c0-7.72 2.76-14.84 8.28-21.36 5.53-6.52 12.44-10.48 20.74-11.88.22 1.74.33 3.37.33 4.89 0 7.61-2.83 14.88-8.5 21.8-5.66 6.92-12.7 10.96-21.12 12.12-.22-1.74-.33-3.37-.33-4.89z"/>
                        </svg>
                        <span>Apple</span>
                    </a>

                    <!-- 3. Microsoft -->
                    <a href="https://www.microsoft.com" target="_blank" class="company-logo-item" title="Microsoft">
                        <svg viewBox="0 0 21 21" width="15" height="15">
                            <rect x="1" y="1" width="9" height="9" fill="#f25022"/>
                            <rect x="11" y="1" width="9" height="9" fill="#7fba00"/>
                            <rect x="1" y="11" width="9" height="9" fill="#00a4ef"/>
                            <rect x="11" y="11" width="9" height="9" fill="#ffb900"/>
                        </svg>
                        <span>Microsoft</span>
                    </a>

                    <!-- 4. Amazon -->
                    <a href="https://www.amazon.jobs" target="_blank" class="company-logo-item" title="Amazon">
                        <svg viewBox="0 0 24 24" width="16" height="16">
                            <path fill="#232F3E" d="M13.9 12.8c-1.9.1-3.7.8-3.7 2.6 0 1.5 1.1 2.3 2.5 2.3 1.9 0 3-1.1 3.5-2.2v1.9h2.3V11c0-2.6-1.8-3.6-4.5-3.6-2.5 0-4.3 1.1-4.7 3.2l2.3.3c.3-1.1 1.2-1.6 2.4-1.6 1.4 0 2.2.6 2.2 1.9v.4c-.6-.4-1.4-.6-2.4-.4zm1.2 2.4c-.4.8-1.2 1.4-2.1 1.4-.8 0-1.4-.4-1.4-1.2 0-1 1-1.4 2.3-1.5.5 0 .9.1 1.2.2v1.1z"/>
                            <path fill="#FF9900" d="M21.7 18.2C17.3 21.4 11.2 22 5.8 19.3c-.8-.4-.1-1.3.7-1 5 2.4 10.7 1.8 14.7-1 .6-.4 1.1.4.5.9z"/>
                            <path fill="#FF9900" d="M22.8 16.8c-.3-.4-1.9-.3-2.9-.2-.3 0-.3-.3 0-.5 1.7-1.1 4.5-.8 4.8-.4.3.4-.4 3.2-2 4.4-.3.2-.5.1-.4-.2.4-.8.8-2.7.5-3.1z"/>
                        </svg>
                        <span>Amazon</span>
                    </a>

                    <!-- 5. Meta -->
                    <a href="https://about.meta.com" target="_blank" class="company-logo-item" title="Meta">
                        <svg viewBox="0 0 24 24" width="16" height="16">
                            <path fill="#0668E1" d="M6.88 4C3.08 4 0 7.15 0 11.04c0 4.19 3.01 7.42 6.69 7.42 2.65 0 4.41-1.46 5.31-2.67.9 1.21 2.66 2.67 5.31 2.67 3.68 0 6.69-3.23 6.69-7.42C24 7.15 20.92 4 17.12 4c-3.1 0-5.12 1.94-5.12 1.94S9.98 4 6.88 4zm0 2.45c1.9 0 3.46 1.48 4.2 3.4-.64 1.63-1.95 3.75-4.2 3.75-1.98 0-3.48-1.58-3.48-3.57 0-2 1.5-3.58 3.48-3.58zm10.24 0c1.98 0 3.48 1.58 3.48 3.58 0 1.99-1.5 3.57-3.48 3.57-2.25 0-3.56-2.12-4.2-3.75.74-1.92 2.3-3.4 4.2-3.4z"/>
                        </svg>
