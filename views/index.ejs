<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head', { title: 'Alumni Tracking System • Apple & RunwayML Edition' }) %>
    <style>
        /* Hero: Apple Museum Scale & Runway Editorial Pacing */
        .hero-section {
            text-align: center;
            padding: 85px 0 65px;
        }

        .hero-eyebrow {
            font-size: 13px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--ink-muted);
            margin-bottom: 14px;
            display: inline-block;
        }

        .hero-title {
            font-size: clamp(42px, 6.5vw, 68px);
            font-weight: 700;
            letter-spacing: -0.04em;
            line-height: 1.05;
            color: var(--ink-pure);
            margin-bottom: 20px;
        }

        .hero-desc {
            font-size: 20px;
            color: var(--ink-secondary);
            max-width: 720px;
            margin: 0 auto 36px;
            line-height: 1.55;
            font-weight: 400;
            letter-spacing: -0.015em;
        }

        .hero-buttons {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 16px;
            flex-wrap: wrap;
        }

        /* Apple Metric Tiles */
        .metric-tiles {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 18px;
            margin: 40px 0 65px;
        }

        .metric-tile {
            background: var(--canvas-card);
            border: 1px solid rgba(0, 0, 0, 0.06);
            border-radius: var(--radius-lg);
            padding: 26px 24px;
            box-shadow: var(--shadow-apple);
        }

        .metric-tile-label {
            font-size: 11.5px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: var(--ink-muted);
            margin-bottom: 6px;
        }

        .metric-tile-value {
            font-size: 28px;
            font-weight: 700;
            letter-spacing: -0.03em;
            color: var(--ink);
        }

        .metric-tile-sub {
            font-size: 13px;
            color: var(--ink-secondary);
            margin-top: 4px;
        }

        /* RunwayML + Apple Module Tiles */
        .tiles-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 22px;
            margin-bottom: 65px;
        }

        .tile-card {
            background: var(--canvas-card);
            border: 1px solid rgba(0, 0, 0, 0.06);
            border-radius: var(--radius-lg);
            padding: 34px 30px;
            text-decoration: none;
            color: inherit;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            box-shadow: var(--shadow-apple);
            transition: all 0.25s ease;
        }

        .tile-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-hover);
        }

        .tile-eyebrow {
            font-size: 11.5px;
            font-weight: 700;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            margin-bottom: 12px;
            display: block;
        }

        .tile-title {
            font-size: 21px;
            font-weight: 700;
            letter-spacing: -0.02em;
            color: var(--ink);
            margin-bottom: 10px;
            line-height: 1.25;
        }

        .tile-desc {
            font-size: 14.5px;
            color: var(--ink-secondary);
            line-height: 1.55;
            margin-bottom: 24px;
        }

        .tile-wide {
            grid-column: span 2;
        }

        /* Apple Dark Feature Showcase Tile */
        .apple-dark-tile {
            background: var(--canvas-tile-dark);
            border-radius: var(--radius-lg);
            padding: 48px 44px;
            color: white;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 32px;
            margin-bottom: 70px;
        }

        .dark-tile-title {
            font-size: 25px;
            font-weight: 700;
            letter-spacing: -0.025em;
            margin-bottom: 8px;
        }

        .dark-tile-desc {
            font-size: 15px;
            color: #86868b;
            max-width: 620px;
            line-height: 1.6;
        }

        @media (max-width: 900px) {
            .metric-tiles { grid-template-columns: repeat(2, 1fr); }
            .tiles-grid { grid-template-columns: repeat(2, 1fr); }
            .tile-wide { grid-column: span 2; }
            .apple-dark-tile { flex-direction: column; align-items: flex-start; }
        }

        @media (max-width: 640px) {
            .metric-tiles, .tiles-grid { grid-template-columns: 1fr; }
            .tile-wide { grid-column: span 1; }
            .hero-title { font-size: 36px; }
            .hero-desc { font-size: 17px; }
        }
    </style>
</head>
<body>
    <%- include('partials/navbar') %>

    <main class="container">
        <!-- Hero Section -->
        <section class="hero-section">
            <span class="hero-eyebrow">Alumni & Career Ecosystem</span>
            <h1 class="hero-title">From Graduation to Career.</h1>
            <p class="hero-desc">
                A modern platform connecting university alumni, active students, and premier career opportunities 
                through RunwayML and Apple design principles.
            </p>
            <div class="hero-buttons">
                <a href="/jobs" class="btn btn-runway" style="padding: 12px 28px; font-size: 15px;">
                    Explore Job Postings
                </a>
                <a href="/users" class="btn btn-outline" style="padding: 12px 26px; font-size: 15px;">
                    Discover Alumni Network ›
                </a>
            </div>
        </section>

        <!-- Metric Ribbon -->
        <div class="metric-tiles">
            <div class="metric-tile">
                <div class="metric-tile-label">Community Network</div>
                <div class="metric-tile-value">Verified</div>
                <div class="metric-tile-sub">Active alumni & student profiles across all majors</div>
            </div>
            <div class="metric-tile">
                <div class="metric-tile-label">Career Desk</div>
                <div class="metric-tile-value">Open Roles</div>
                <div class="metric-tile-sub">Full-time, remote & internship opportunities</div>
            </div>
            <div class="metric-tile">
                <div class="metric-tile-label">Career Pathways</div>
                <div class="metric-tile-value">Direct Apply</div>
                <div class="metric-tile-sub">Transparent candidate & recruiter pipeline</div>
            </div>
            <div class="metric-tile">
                <div class="metric-tile-label">Alumni Mentorship</div>
                <div class="metric-tile-value">Lifelong</div>
                <div class="metric-tile-sub">Continuous professional guidance & networking</div>
            </div>
        </div>

        <!-- Museum Product Modules -->
        <div class="tiles-grid">
            <!-- Users Tile -->
            <a href="/users" class="tile-card">
                <div>
                    <span class="tile-eyebrow" style="color: var(--mod-users-fg);">01 &bull; Directory</span>
                    <h2 class="tile-title">Members & Alumni Directory</h2>
                    <p class="tile-desc">
                        Explore member profiles, filter by academic department, register new graduates, and track career journeys.
                    </p>
                </div>
                <div>
                    <span class="link-chevron">Manage Profiles ›</span>
                </div>
            </a>

            <!-- Jobs Tile -->
            <a href="/jobs" class="tile-card">
                <div>
                    <span class="tile-eyebrow" style="color: var(--mod-jobs-fg);">02 &bull; Career Hub</span>
                    <h2 class="tile-title">Job & Internship Postings</h2>
                    <p class="tile-desc">
                        Filter open positions, explore hiring companies, publish new opportunities, and review applicant submissions.
                    </p>
                </div>
                <div>
                    <span class="link-chevron">Explore Careers ›</span>
                </div>
            </a>

            <!-- Applications Tile -->
            <a href="/applications" class="tile-card">
                <div>
                    <span class="tile-eyebrow" style="color: var(--mod-apps-fg);">03 &bull; Evaluation</span>
                    <h2 class="tile-title">Application Pipeline</h2>
                    <p class="tile-desc">
                        Manage submitted applications, recruitment stages (Interviewing, Accepted), cover letters, and candidate resumes.
                    </p>
                </div>
                <div>
                    <span class="link-chevron">Review Applications ›</span>
                </div>
            </a>

            <!-- Announcements Tile -->
            <a href="/announcements" class="tile-card">
                <div>
                    <span class="tile-eyebrow" style="color: var(--mod-announ-fg);">04 &bull; Newsroom</span>
                    <h2 class="tile-title">Notices & Campus Events</h2>
                    <p class="tile-desc">
                        Discover university notices, scholarships, career seminars, and alumni reunion events in real time.
                    </p>
                </div>
                <div>
                    <span class="link-chevron">Read Announcements ›</span>
                </div>
            </a>

            <!-- REST API Tile (Wide) -->
            <a href="/api/swagger" target="_blank" class="tile-card tile-wide">
                <div>
                    <span class="tile-eyebrow" style="color: var(--mod-api-fg);">05 &bull; REST API v1</span>
                    <h2 class="tile-title">Swagger UI & OpenAPI Specifications</h2>
                    <p class="tile-desc">
                        Developer-friendly JSON API endpoints across all domains. Test requests interactively using Swagger and Postman.
                    </p>
                </div>
                <div>
                    <span class="link-chevron">Launch API Console ›</span>
                </div>
            </a>
        </div>

        <!-- Apple Dark Feature Showcase Tile -->
        <div class="apple-dark-tile">
            <div>
                <h3 class="dark-tile-title">🛡️ Built for High Reliability & Scale</h3>
                <p class="dark-tile-desc">
                    Enterprise-grade architecture featuring automated request logging, 
                    fault-tolerant failover safeguards, and dedicated audit logging for 24/7 uptime.
                </p>
            </div>
            <div style="display: flex; gap: 12px; flex-shrink: 0;">
                <a href="/api/health" target="_blank" class="btn" style="background: rgba(255, 255, 255, 0.15); color: white; border: 1px solid rgba(255, 255, 255, 0.2);">
                    Health Check
                </a>
                <a href="/about" class="btn" style="background: white; color: black;">
                    About Us
                </a>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
