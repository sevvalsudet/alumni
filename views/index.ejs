<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head', { title: 'Alumni Tracking System • Apple & RunwayML Edition' }) %>
    <style>
        /* Hero: Apple Museum Scale & Runway Editorial Pacing */
        .hero-section {
            text-align: center;
            padding: 55px 0 24px;
        }

        .hero-eyebrow {
            font-size: 13px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--ink-muted);
            margin-bottom: 14px;
            display: inline-block;
        }

        .hero-title {
            font-size: clamp(42px, 6.5vw, 68px);
            font-weight: 700;
            letter-spacing: -0.04em;
            line-height: 1.05;
            color: var(--ink-pure);
            margin-bottom: 20px;
        }

        .hero-desc {
            font-size: 20px;
            color: var(--ink-secondary);
            max-width: 720px;
            margin: 0 auto 36px;
            line-height: 1.55;
            font-weight: 400;
            letter-spacing: -0.015em;
        }

        .hero-buttons {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 16px;
            flex-wrap: wrap;
        }

        /* 1. VISUAL: Minimalist Monochrome Network Graph */
        .constellation-card {
            background: #ffffff;
            border: 1px solid rgba(0, 0, 0, 0.06);
            border-radius: var(--radius-lg);
            padding: 24px 32px 18px;
            box-shadow: var(--shadow-apple);
            margin: 20px 0 20px;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .constellation-header {
            max-width: 680px;
            margin: 0 auto 16px;
        }

        .constellation-header h3 {
            font-size: 20px;
            font-weight: 700;
            letter-spacing: -0.03em;
            color: var(--ink);
            margin-bottom: 4px;
        }

        .constellation-header p {
            font-size: 13px;
            color: var(--ink-secondary);
            line-height: 1.5;
        }

        .constellation-svg-wrapper {
            width: 100%;
            max-width: 820px;
            margin: 0 auto;
            position: relative;
        }

        .constellation-svg {
            width: 100%;
            height: auto;
            display: block;
        }

        .constellation-legend {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 20px;
            margin-top: 10px;
            flex-wrap: wrap;
            font-size: 11.5px;
            color: var(--ink-muted);
        }

        .legend-item {
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .legend-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #86868b;
        }

        /* 2. VISUAL: Monochrome Partner Company Logo Cloud */
        .company-cloud-section {
            padding: 10px 0 30px;
            text-align: center;
        }

        .company-cloud-label {
            font-size: 11.5px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            color: var(--ink-muted);
            margin-bottom: 28px;
            display: block;
        }

        .company-logos-row {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: clamp(24px, 5vw, 64px);
            flex-wrap: wrap;
        }

        .company-logo-item {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: #86868b;
            font-size: 16px;
            font-weight: 600;
            letter-spacing: -0.02em;
            opacity: 0.75;
            transition: all 0.2s ease;
            text-decoration: none;
        }

        .company-logo-item:hover {
            color: var(--ink-pure);
            opacity: 1;
            transform: translateY(-1px);
        }

        .company-logo-item svg {
            height: 22px;
            width: auto;
            fill: currentColor;
        }

        /* 3. VISUAL: Horizontal Scrollable Alumni Spotlight Cards */
        .spotlight-section {
            margin-bottom: 75px;
        }

        .spotlight-header-row {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            margin-bottom: 24px;
            flex-wrap: wrap;
            gap: 16px;
        }

        .spotlight-header-row h2 {
            font-size: 28px;
            font-weight: 700;
            letter-spacing: -0.03em;
            color: var(--ink);
            margin-bottom: 6px;
        }

        .spotlight-header-row p {
            font-size: 15px;
            color: var(--ink-secondary);
        }

        .spotlight-scroll-container {
            display: flex;
            gap: 20px;
            overflow-x: auto;
            padding: 10px 4px 24px;
            scroll-snap-type: x mandatory;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: thin;
        }

        .spotlight-scroll-container::-webkit-scrollbar {
            height: 6px;
        }
        .spotlight-scroll-container::-webkit-scrollbar-thumb {
            background: rgba(0, 0, 0, 0.15);
            border-radius: var(--radius-pill);
        }

        .spotlight-card {
            flex: 0 0 320px;
            scroll-snap-align: start;
            background: #ffffff;
            border: 1px solid rgba(0, 0, 0, 0.06);
            border-radius: var(--radius-lg);
            padding: 28px 24px;
            box-shadow: var(--shadow-apple);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: all 0.25s ease;
        }

        .spotlight-card:hover {
            transform: translateY(-3px);
            box-shadow: var(--shadow-hover);
        }

        .spotlight-top {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-bottom: 16px;
        }

        .spotlight-avatar {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 16px;
            color: #ffffff;
            flex-shrink: 0;
        }

        .avatar-1 { background: linear-gradient(135deg, #0071e3, #47a3ff); }
        .avatar-2 { background: linear-gradient(135deg, #1d1d1f, #48484a); }
        .avatar-3 { background: linear-gradient(135deg, #f56300, #ff8c38); }
        .avatar-4 { background: linear-gradient(135deg, #34c759, #30d158); }
        .avatar-5 { background: linear-gradient(135deg, #af52de, #bf5af2); }

        .spotlight-name {
            font-size: 16.5px;
            font-weight: 700;
            color: var(--ink);
            letter-spacing: -0.02em;
        }

        .spotlight-role {
            font-size: 13px;
            color: var(--apple-blue);
            font-weight: 500;
        }

        .spotlight-meta-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: var(--canvas-parchment);
            padding: 4px 10px;
            border-radius: var(--radius-pill);
            font-size: 12px;
            color: var(--ink-secondary);
            margin-bottom: 14px;
            border: 1px solid rgba(0, 0, 0, 0.04);
        }

        .spotlight-quote {
            font-size: 14px;
            color: var(--ink-secondary);
            line-height: 1.55;
            font-style: italic;
            margin-bottom: 20px;
        }

        .spotlight-action {
            margin-top: auto;
            border-top: 1px solid var(--hairline-soft);
            padding-top: 14px;
        }

        /* Product Modules Grid */
        .tiles-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 22px;
            margin-bottom: 65px;
        }

        .tile-card {
            background: var(--canvas-card);
            border: 1px solid rgba(0, 0, 0, 0.06);
            border-radius: var(--radius-lg);
            padding: 34px 30px;
            text-decoration: none;
            color: inherit;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            box-shadow: var(--shadow-apple);
            transition: all 0.25s ease;
        }

        .tile-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-hover);
        }

        .tile-eyebrow {
            font-size: 11.5px;
            font-weight: 700;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            margin-bottom: 12px;
            display: block;
        }

        .tile-title {
            font-size: 21px;
            font-weight: 700;
            letter-spacing: -0.02em;
            color: var(--ink);
            margin-bottom: 10px;
            line-height: 1.25;
        }

        .tile-desc {
            font-size: 14.5px;
            color: var(--ink-secondary);
            line-height: 1.55;
            margin-bottom: 24px;
        }

        .tile-wide {
            grid-column: span 2;
        }

        /* Apple Dark Feature Showcase Tile */
        .apple-dark-tile {
            background: var(--canvas-tile-dark);
            border-radius: var(--radius-lg);
            padding: 24px 32px;
            color: white;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 24px;
            margin-bottom: 50px;
        }

        .dark-tile-title {
            font-size: 18px;
            font-weight: 700;
            letter-spacing: -0.025em;
            margin-bottom: 4px;
        }

        .dark-tile-desc {
            font-size: 13px;
            color: #86868b;
            max-width: 620px;
            line-height: 1.5;
        }

        @media (max-width: 900px) {
            .tiles-grid { grid-template-columns: repeat(2, 1fr); }
            .tile-wide { grid-column: span 2; }
            .apple-dark-tile { flex-direction: column; align-items: flex-start; }
        }

        @media (max-width: 640px) {
            .tiles-grid { grid-template-columns: 1fr; }
            .tile-wide { grid-column: span 1; }
            .hero-title { font-size: 36px; }
            .hero-desc { font-size: 17px; }
        }
    </style>
</head>
<body>
    <%- include('partials/navbar') %>

    <main class="container">
        <!-- Hero Section -->
        <section class="hero-section">
            <span class="hero-eyebrow">Alumni & Career Ecosystem</span>
            <h1 class="hero-title">From Graduation to Career.</h1>
            <p class="hero-desc">
                Connecting university alumni and students to build lifelong professional relationships, 
                share verified career opportunities, and empower the next generation of leaders.
            </p>
            <div class="hero-buttons">
                <a href="/jobs" class="btn btn-runway" style="padding: 12px 28px; font-size: 15px;">
                    Explore Job Postings
                </a>
                <a href="/users" class="btn btn-outline" style="padding: 12px 26px; font-size: 15px;">
                    Discover Alumni Network ›
                </a>
            </div>
        </section>

        <!-- 1. VISUAL: Minimalist Monochrome Network Graph -->
        <section class="constellation-card">
            <div class="constellation-header">
                <span class="hero-eyebrow" style="color: var(--ink-muted);">Live Ecosystem Graph</span>
                <h3>Connecting Every Graduation Journey</h3>
                <p>Alumni, students, and companies — all in one network.</p>
            </div>

            <div class="constellation-svg-wrapper">
                <svg class="constellation-svg" viewBox="0 0 820 180" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <!-- Thin connecting lines -->
                    <line x1="80"  y1="90"  x2="220" y2="45"  stroke="#d2d2d7" stroke-width="1"/>
                    <line x1="80"  y1="90"  x2="220" y2="135" stroke="#d2d2d7" stroke-width="1"/>
                    <line x1="220" y1="45"  x2="410" y2="90"  stroke="#d2d2d7" stroke-width="1"/>
                    <line x1="220" y1="135" x2="410" y2="90"  stroke="#d2d2d7" stroke-width="1"/>
                    <line x1="410" y1="90"  x2="600" y2="45"  stroke="#d2d2d7" stroke-width="1"/>
                    <line x1="410" y1="90"  x2="600" y2="135" stroke="#d2d2d7" stroke-width="1"/>
                    <line x1="600" y1="45"  x2="740" y2="90"  stroke="#d2d2d7" stroke-width="1"/>
                    <line x1="600" y1="135" x2="740" y2="90"  stroke="#d2d2d7" stroke-width="1"/>
                    <line x1="220" y1="45"  x2="600" y2="45"  stroke="#e8e8ed" stroke-width="1" stroke-dasharray="3 5"/>
                    <line x1="220" y1="135" x2="600" y2="135" stroke="#e8e8ed" stroke-width="1" stroke-dasharray="3 5"/>

                    <!-- Nodes: small circles -->
                    <circle cx="80"  cy="90"  r="10" fill="#f5f5f7" stroke="#86868b" stroke-width="1.5"/>
                    <circle cx="220" cy="45"  r="7"  fill="#f5f5f7" stroke="#86868b" stroke-width="1.2"/>
                    <circle cx="220" cy="135" r="7"  fill="#f5f5f7" stroke="#86868b" stroke-width="1.2"/>
                    <circle cx="410" cy="90"  r="14" fill="#f0f0f5" stroke="#1d1d1f" stroke-width="1.8"/>
                    <circle cx="600" cy="45"  r="7"  fill="#f5f5f7" stroke="#86868b" stroke-width="1.2"/>
                    <circle cx="600" cy="135" r="7"  fill="#f5f5f7" stroke="#86868b" stroke-width="1.2"/>
                    <circle cx="740" cy="90"  r="10" fill="#f5f5f7" stroke="#86868b" stroke-width="1.5"/>

                    <!-- Center dot fill -->
                    <circle cx="410" cy="90" r="5" fill="#1d1d1f"/>

                    <!-- Labels -->
                    <text x="80"  y="78"  text-anchor="middle" font-size="10" fill="#86868b" font-family="-apple-system, sans-serif">Students</text>
                    <text x="220" y="33"  text-anchor="middle" font-size="10" fill="#86868b" font-family="-apple-system, sans-serif">Mentors</text>
                    <text x="220" y="155" text-anchor="middle" font-size="10" fill="#86868b" font-family="-apple-system, sans-serif">Internships</text>
                    <text x="410" y="115" text-anchor="middle" font-size="10.5" font-weight="600" fill="#1d1d1f" font-family="-apple-system, sans-serif">Alumni Network</text>
                    <text x="600" y="33"  text-anchor="middle" font-size="10" fill="#86868b" font-family="-apple-system, sans-serif">Tech Leaders</text>
                    <text x="600" y="155" text-anchor="middle" font-size="10" fill="#86868b" font-family="-apple-system, sans-serif">Scaleups</text>
                    <text x="740" y="78"  text-anchor="middle" font-size="10" fill="#86868b" font-family="-apple-system, sans-serif">Alumni</text>
                </svg>
            </div>

            <div class="constellation-legend">
                <span class="legend-item"><span class="legend-dot"></span> Active Students</span>
                <span class="legend-item"><span class="legend-dot"></span> University Alumni</span>
                <span class="legend-item"><span class="legend-dot"></span> Partner Companies</span>
            </div>
        </section>

        <!-- 2. VISUAL: Monochrome Partner Company Logo Cloud -->
        <section class="company-cloud-section">
            <span class="company-cloud-label">Where Our Graduates Work & Hire</span>
            <div class="company-logos-row">
                <!-- Google -->
                <div class="company-logo-item">
                    <svg viewBox="0 0 24 24"><path d="M12.48 10.92v3.28h7.84c-.24 1.84-.853 3.187-1.787 4.133-1.147 1.147-2.933 2.4-6.053 2.4-4.827 0-8.6-3.893-8.6-8.72s3.773-8.72 8.6-8.72c2.6 0 4.507 1.027 5.907 2.347l2.307-2.307C18.747 1.44 16.133 0 12.48 0 5.867 0 .307 5.387.307 12s5.56 12 12.173 12c3.573 0 6.267-1.173 8.373-3.36 2.16-2.16 2.84-5.213 2.84-7.667 0-.76-.053-1.467-.173-2.053H12.48z"/></svg>
                    <span>Google</span>
                </div>
                <!-- Apple -->
                <div class="company-logo-item">
                    <svg viewBox="0 0 24 24"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.63-.76 1.05-1.82.93-2.88-.9.04-2 .6-2.65 1.37-.58.67-.98 1.76-.84 2.8.99.08 2.03-.53 2.56-1.29z"/></svg>
                    <span>Apple</span>
                </div>
                <!-- Microsoft -->
                <div class="company-logo-item">
                    <svg viewBox="0 0 24 24"><path d="M0 0h11.377v11.377H0zm12.623 0H24v11.377H12.623zM0 12.623h11.377V24H0zm12.623 0H24V24H12.623z"/></svg>
                    <span>Microsoft</span>
                </div>
                <!-- Amazon -->
                <div class="company-logo-item">
                    <svg viewBox="0 0 24 24"><path d="M13.924 16.14c-4.004 2.955-9.845 1.572-13.35-.985-.262-.19-.045-.55.247-.414 3.774 1.762 8.766 2.33 12.617-.46.398-.29.824.234.486.86zm1.187-1.428c-.463-.59-3.07-.279-4.24-.141-.358.043-.414-.287-.093-.51 2.083-1.44 5.485-1.026 6.012-.358.528.667-.14 3.992-2.11 5.56-.303.242-.591.114-.457-.202.443-1.042 1.35-3.759.888-4.349z"/></svg>
                    <span>Amazon</span>
                </div>
                <!-- Trendyol -->
                <div class="company-logo-item">
                    <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 15h-2v-6H7v-2h6v8zm4 0h-2V7h2v10z"/></svg>
                    <span>Trendyol</span>
                </div>
                <!-- Stripe -->
                <div class="company-logo-item">
                    <svg viewBox="0 0 24 24"><path d="M13.976 9.15c-2.172-.806-3.356-1.426-3.356-2.409 0-.831.683-1.305 1.901-1.305 2.227 0 4.515.858 6.09 1.631l.89-5.494C18.252.975 15.697.5 12.619.5 7.158.5 3.328 3.356 3.328 7.64c0 3.318 2.052 5.037 5.626 6.37 2.45.922 3.284 1.623 3.284 2.607 0 .977-.852 1.505-2.28 1.505-2.203 0-4.996-1.09-6.938-2.181l-.914 5.666c1.882.88 4.796 1.493 7.852 1.493 5.753 0 9.774-2.738 9.774-7.256 0-3.522-2.118-5.267-5.755-6.694z"/></svg>
                    <span>Stripe</span>
                </div>
            </div>
        </section>

        <!-- 3. VISUAL: Horizontal Scrollable Alumni Spotlight Cards -->
        <section class="spotlight-section">
            <div class="spotlight-header-row">
                <div>
                    <span class="hero-eyebrow" style="color: var(--apple-blue); margin-bottom: 6px;">Alumni Spotlights</span>
                    <h2>Meet Leaders from Our Network</h2>
                    <p>Discover how graduates are innovating and mentoring across leading tech and creative hubs.</p>
                </div>
                <div style="font-size: 13px; color: var(--ink-muted);">
                    <span>Scroll horizontally to explore &rarr;</span>
                </div>
            </div>

            <div class="spotlight-scroll-container">
                <!-- Spotlight Card 1 -->
                <div class="spotlight-card">
                    <div>
                        <div class="spotlight-top">
                            <div class="spotlight-avatar avatar-1">AK</div>
                            <div>
                                <div class="spotlight-name">Ayşe Kaya</div>
                                <div class="spotlight-role">Senior ML Engineer</div>
                            </div>
                        </div>
                        <div class="spotlight-meta-badge">
                            🏢 Google &bull; Mountain View, CA
                        </div>
                        <p class="spotlight-quote">
                            "Mentoring current students and opening direct referral tracks for AI roles has been one of the most fulfilling journeys since graduating."
                        </p>
                    </div>
                    <div class="spotlight-action">
                        <span style="font-size: 12px; color: var(--ink-muted);">Class of '20 &bull; Computer Eng.</span>
                    </div>
                </div>

                <!-- Spotlight Card 2 -->
                <div class="spotlight-card">
                    <div>
                        <div class="spotlight-top">
                            <div class="spotlight-avatar avatar-2">MT</div>
                            <div>
                                <div class="spotlight-name">Mehmet Tan</div>
                                <div class="spotlight-role">Staff Product Designer</div>
                            </div>
                        </div>
                        <div class="spotlight-meta-badge">
                            🏢 Apple &bull; Cupertino, CA
                        </div>
                        <p class="spotlight-quote">
                            "The university design critique sessions laid the exact foundation needed to design hardware & software experiences at global scale."
                        </p>
                    </div>
                    <div class="spotlight-action">
                        <span style="font-size: 12px; color: var(--ink-muted);">Class of '19 &bull; Industrial Design</span>
                    </div>
                </div>

                <!-- Spotlight Card 3 -->
                <div class="spotlight-card">
                    <div>
                        <div class="spotlight-top">
                            <div class="spotlight-avatar avatar-3">ZD</div>
                            <div>
                                <div class="spotlight-name">Zeynep Demir</div>
                                <div class="spotlight-role">Lead Software Architect</div>
                            </div>
                        </div>
                        <div class="spotlight-meta-badge">
                            🏢 Trendyol &bull; Istanbul, TR
                        </div>
                        <p class="spotlight-quote">
                            "We actively scout our backend interns and junior engineers directly through our alumni portal every recruitment cycle."
                        </p>
                    </div>
                    <div class="spotlight-action">
                        <span style="font-size: 12px; color: var(--ink-muted);">Class of '18 &bull; Software Eng.</span>
                    </div>
                </div>

                <!-- Spotlight Card 4 -->
                <div class="spotlight-card">
                    <div>
                        <div class="spotlight-top">
                            <div class="spotlight-avatar avatar-4">CA</div>
                            <div>
                                <div class="spotlight-name">Can Arslan</div>
                                <div class="spotlight-role">Cloud Solutions Lead</div>
                            </div>
                        </div>
                        <div class="spotlight-meta-badge">
                            🏢 Amazon AWS &bull; Dublin, IE
                        </div>
                        <p class="spotlight-quote">
                            "From campus hackathons to architecting multi-region clouds at AWS, peer connections from this network made all the difference."
                        </p>
                    </div>
                    <div class="spotlight-action">
                        <span style="font-size: 12px; color: var(--ink-muted);">Class of '21 &bull; Electrical Eng.</span>
                    </div>
                </div>

                <!-- Spotlight Card 5 -->
                <div class="spotlight-card">
                    <div>
                        <div class="spotlight-top">
                            <div class="spotlight-avatar avatar-5">EY</div>
                            <div>
                                <div class="spotlight-name">Elif Yılmaz</div>
                                <div class="spotlight-role">VP of Operations</div>
                            </div>
                        </div>
                        <div class="spotlight-meta-badge">
                            🏢 Stripe &bull; London, UK
                        </div>
                        <p class="spotlight-quote">
                            "A connected alumni platform creates serendipitous partnerships for startup founders and operators navigating global expansion."
                        </p>
                    </div>
                    <div class="spotlight-action">
                        <span style="font-size: 12px; color: var(--ink-muted);">Class of '17 &bull; Economics</span>
                    </div>
                </div>
            </div>
        </section>

