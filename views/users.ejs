<!DOCTYPE html>
<html lang="tr">
<head>
    <%- include('partials/head', { title: 'Mezunlar & Kullanıcılar • Alumni.io' }) %>
</head>
<body>
    <%- include('partials/navbar', { active: 'users' }) %>

    <main class="container">
        <div class="page-header">
            <h1>👥 Mezun & Öğrenci Yönetimi</h1>
            <p class="subtitle">Platformdaki tüm mezun ve öğrenci profillerini görüntüleyin, arayın ve yeni kayıtlar ekleyin.</p>
        </div>

        <!-- ➕ 1. CREATE: POST /users Formu -->
        <div class="card">
            <h2>
                <span>➕ Yeni Kullanıcı Ekle</span>
                <span class="badge badge-primary">CREATE</span>
            </h2>
            <form action="/users" method="POST">
                <div class="form-grid">
                    <div class="form-group">
                        <label for="name">Ad Soyad *</label>
                        <input type="text" id="name" name="name" placeholder="Örn: Ayşe Kaya" required>
                    </div>
                    <div class="form-group">
                        <label for="role">Rol *</label>
                        <select id="role" name="role" required>
                            <option value="Alumni">Mezun (Alumni)</option>
                            <option value="Student">Öğrenci (Student)</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="department">Bölüm</label>
                        <input type="text" id="department" name="department" placeholder="Örn: Bilgisayar Mühendisliği">
                    </div>
                    <div class="form-group">
                        <label for="company">Şirket / Kurum</label>
                        <input type="text" id="company" name="company" placeholder="Örn: Google / Trendyol">
                    </div>
                    <div class="form-group full" style="margin-top: 8px;">
                        <button type="submit" class="btn btn-runway" style="width: 100%;">
                            <span>Kullanıcıyı Kaydet</span>
                            <span>→</span>
                        </button>
                    </div>
                </div>
            </form>
        </div>

        <!-- 📖 2. READ: GET /users Listeleme & UPDATE & DELETE İşlemleri -->
        <div class="card">
            <h2>
                <span>📋 Kayıtlı Kullanıcılar Portföyü</span>
                <span class="badge badge-users"><%= users ? users.length : 0 %> Profil</span>
            </h2>
            <div class="table-responsive">
                <table>
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Ad Soyad</th>
                            <th>Rol</th>
                            <th>Bölüm</th>
                            <th>Şirket</th>
                            <th style="text-align: right;">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (users && users.length > 0) { %>
                            <% users.forEach(user => { %>
                                <tr>
                                    <td><strong style="color: var(--ink);">#<%= user.id %></strong></td>
                                    <td>
                                        <div style="font-weight: 600; color: var(--ink);"><%= user.name %></div>
                                    </td>
                                    <td>
                                        <span class="badge <%= user.role === 'Student' ? 'badge-users' : 'badge-jobs' %>">
                                            <%= user.role === 'Student' ? '🎓 Öğrenci' : '💼 Mezun' %>
                                        </span>
                                    </td>
                                    <td><%= user.department || '—' %></td>
                                    <td><%= user.company || '—' %></td>
                                    <td style="text-align: right;">
                                        <div class="table-actions" style="justify-content: flex-end;">
                                            <a href="/users/<%= user.id %>" class="action-pill action-view" title="Profil Detayı">İncele</a>
                                            <a href="/users/<%= user.id %>/edit" class="action-pill action-edit" title="Düzenle">Düzenle</a>
                                            <form action="/users/<%= user.id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Bu kullanıcıyı silmek istediğinize emin misiniz?');">
                                                <button type="submit" class="action-pill action-delete">Sil</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="6" style="text-align: center; color: var(--stone); padding: 35px 20px;">
                                    Henüz kayıtlı bir kullanıcı bulunmuyor.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
