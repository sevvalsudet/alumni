<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head', { title: '404 • Page Not Found • Alumni.io' }) %>
    <style>
        .error-card {
            max-width: 680px;
            margin: 48px auto;
            text-align: center;
            padding: 48px 32px;
        }
        .error-icon {
            width: 72px;
            height: 72px;
            margin: 0 auto 20px;
            background: var(--status-red-bg);
            border: 1px solid rgba(255, 59, 48, 0.2);
            border-radius: var(--radius-lg);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 32px;
        }
        .route-pill {
            display: inline-block;
            background: var(--canvas-parchment);
            border: 1px solid rgba(0, 0, 0, 0.08);
            padding: 6px 14px;
            border-radius: var(--radius-pill);
            font-family: monospace;
            font-size: 13px;
            color: var(--ink);
            margin: 18px 0 28px;
        }
    </style>
</head>
<body>
    <%- include('partials/navbar') %>

    <main class="container">
        <div class="card error-card">
            <div class="error-icon">🛡️</div>
            <h1 style="font-size: 28px; font-weight: 700; color: var(--status-red); margin-bottom: 8px; letter-spacing: -0.02em;">
                404 • Page Not Found
            </h1>
            <p style="color: var(--ink-secondary); font-size: 15px; line-height: 1.6;">
                The resource you are looking for does not exist, has been removed, or has moved to a new route.<br>
                <strong>404 Guardian Middleware</strong> intercepted this request safely.
            </p>

            <div class="route-pill">
                <% if (typeof url !== 'undefined' && url) { %>
                    [<%= typeof method !== 'undefined' ? method : 'GET' %>] <%= url %>
                <% } else { %>
                    404 Not Found &bull; Invalid Route
                <% } %>
            </div>

            <div style="display: flex; justify-content: center; gap: 12px; flex-wrap: wrap;">
                <a href="/" class="btn btn-runway">Back to Homepage</a>
                <a href="javascript:history.back()" class="btn btn-secondary">← Go Back</a>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
