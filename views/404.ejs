<!DOCTYPE html>
<html lang="tr">
<head>
    <%- include('partials/head', { title: '404 • Sayfa Bulunamadı' }) %>
    <style>
        .error-card {
            max-width: 640px;
            margin: 40px auto;
            text-align: center;
            padding: 48px 32px;
        }
        .error-icon {
            width: 80px;
            height: 80px;
            margin: 0 auto 20px;
            background: var(--danger-bg);
            border: 1px solid var(--danger-border);
            border-radius: var(--radius-lg);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 36px;
        }
        .route-pill {
            display: inline-block;
            background: var(--canvas-subtle);
            border: 1px solid var(--hairline);
            padding: 6px 14px;
            border-radius: var(--radius-pill);
            font-family: monospace;
            font-size: 13.5px;
            color: var(--ink);
            margin: 18px 0 28px;
        }
    </style>
</head>
<body>
    <%- include('partials/navbar') %>

    <main class="container">
        <div class="card error-card">
            <div class="error-icon">🛡️</div>
            <h1 style="font-size: 28px; font-weight: 800; color: var(--danger); margin-bottom: 8px;">
                404 • Sayfa Bulunamadı
            </h1>
            <p style="color: var(--slate); font-size: 15px; line-height: 1.6;">
                Aradığınız kaynak mevcut değil, silinmiş ya da taşınmış olabilir.<br>
                <strong>404 Guardian Middleware</strong> isteği yakaladı ve güvenle sonlandırdı.
            </p>

            <div class="route-pill">
                <% if (typeof url !== 'undefined' && url) { %>
                    [<%= typeof method !== 'undefined' ? method : 'GET' %>] <%= url %>
                <% } else { %>
                    404 Not Found &bull; Geçersiz Rota
                <% } %>
            </div>

            <div style="display: flex; justify-content: center; gap: 12px; flex-wrap: wrap;">
                <a href="/" class="btn btn-primary">Ana Sayfaya Dön</a>
                <a href="javascript:history.back()" class="btn btn-secondary">← Geri Git</a>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
