<!-- views/partials/navbar.ejs -->
<%
    const isSubpage = (typeof active !== 'undefined' && active && active !== 'home');
    const navThemeClass = isSubpage ? 'apple-nav-light' : 'apple-nav-dark';
%>
<nav class="apple-nav <%= navThemeClass %>">
    <div class="container">
        <div class="apple-nav-inner">
            <a href="/" class="nav-brand">
                <svg class="nav-brand-icon-svg" viewBox="0 0 24 24" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path class="cap-fill" d="M2 10l10-5 10 5-10 5z" fill="#ffffff" stroke="#ffffff"/>
                    <path class="cap-fill" d="M6 12v5c0 2 2.5 3 6 3s6-1 6-3v-5" fill="#ffffff" stroke="#ffffff"/>
                    <path class="cap-tassel" d="M22 10v6" fill="none" stroke="#ffffff" stroke-width="2"/>
                </svg>
                <span>Alumni</span>
            </a>
            
            <div class="nav-items">
                <a href="/users" class="nav-item <%= typeof active !== 'undefined' && active === 'users' ? 'active' : '' %>">Members</a>
                <a href="/jobs" class="nav-item <%= typeof active !== 'undefined' && active === 'jobs' ? 'active' : '' %>">Jobs</a>
                <a href="/applications" class="nav-item <%= typeof active !== 'undefined' && active === 'applications' ? 'active' : '' %>">Applications</a>
                <a href="/announcements" class="nav-item <%= typeof active !== 'undefined' && active === 'announcements' ? 'active' : '' %>">Announcements</a>
                <a href="/api/swagger" target="_blank" class="nav-item">API Docs</a>
                <a href="/about" class="nav-item <%= typeof active !== 'undefined' && active === 'about' ? 'active' : '' %>">About</a>
                <a href="/register" class="nav-item <%= typeof active !== 'undefined' && active === 'register' ? 'active' : '' %>" style="font-weight: 600; padding: 4px 12px; border-radius: var(--radius-pill); border: 1px solid rgba(255,255,255,0.25);">Register</a>
            </div>
        </div>
    </div>
</nav>
