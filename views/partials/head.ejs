<!-- views/partials/head.ejs -->
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= typeof title !== 'undefined' ? title : 'Alumni Tracking System' %></title>

<!-- Fonts: Inter + SF Pro Display Fallback (RunwayML + Apple authentic typography) -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

<style>
    :root {
        /* RunwayML + Apple Palette */
        --canvas: #ffffff;
        --canvas-parchment: rgb(255, 255, 255); /* Pure white page background */
        --canvas-card: rgb(245, 245, 247);      /* Apple light subtle gray */
        --canvas-tile-dark: #161617; /* Apple dark showcase tile */
        
        --ink: #1d1d1f;             /* Apple signature text */
        --ink-pure: #030303;        /* Runway pure black ink */
        --ink-secondary: #515154;
        --ink-muted: #86868b;       /* Apple muted text */
        
        --hairline: #d2d2d7;        /* Apple hairline divider */
        --hairline-soft: #e5e5ea;
        --hairline-runway: #e7eaf0; /* Runway hairline */
        
        /* Interactive Colors */
        --apple-blue: #0071e3;      /* Apple Action Blue */
        --apple-blue-hover: #0077ed;
        --runway-black: #000000;    /* Runway solid black CTA */
        --runway-black-hover: #1f1f1f;
        
        /* Module Accents (Soft Museum Pastels) */
        --mod-users-bg: #e8f0fe;    --mod-users-fg: #1967d2;
        --mod-jobs-bg: #e6f4ea;     --mod-jobs-fg: #137333;
        --mod-apps-bg: #f3e8fd;     --mod-apps-fg: #7b1fa2;
        --mod-announ-bg: #fef7e0;   --mod-announ-fg: #b06000;
        --mod-api-bg: #e4f7fb;      --mod-api-fg: #007b83;
        
        /* Status */
        --status-green: #34c759;
        --status-green-bg: #e8f8ed;
        --status-red: #ff3b30;
        --status-red-bg: #fdeeee;
        
        /* Radii (Apple 18px tiles & Runway 9999px pills) */
        --radius-sm: 8px;
        --radius-md: 12px;
        --radius-lg: 18px;          /* Apple tile radius */
        --radius-pill: 9999px;      /* Runway & Apple pill CTA */
        
        /* Apple Elevation: Whisper-soft */
        --shadow-apple: 0 4px 20px rgba(0, 0, 0, 0.03);
        --shadow-hover: 0 12px 32px rgba(0, 0, 0, 0.07);
        --shadow-pill: 0 2px 8px rgba(0, 113, 227, 0.25);
    }

    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "SF Pro Display", "Inter", sans-serif;
        background-color: var(--canvas-parchment);
        color: var(--ink);
        line-height: 1.5;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        -webkit-font-smoothing: antialiased;
        letter-spacing: -0.01em;
    }

    .container {
        max-width: 1600px;
        margin: 0 auto;
        padding: 0 16px;
        width: 100%;
    }

    /* Apple Global Navigation: Exact 44px SF Pro Cadence */
    nav.apple-nav {
        position: sticky;
        top: 0;
        z-index: 999;
        height: 44px;
        display: flex;
        align-items: center;
        font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "SF Pro Display", "Inter", sans-serif;
        font-size: 12px;
        letter-spacing: -0.01em;
        transition: background-color 0.25s ease, border-color 0.25s ease;
    }

    /* 1. Apple Homepage Dark Navigation (#252527) */
    nav.apple-nav.apple-nav-dark {
        background: rgba(29, 29, 31, 1);
        backdrop-filter: saturate(180%) blur(20px);
        -webkit-backdrop-filter: saturate(180%) blur(20px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }
    nav.apple-nav.apple-nav-dark .nav-brand {
        color: #ffffff;
    }
    nav.apple-nav.apple-nav-dark .nav-brand-icon-svg path.cap-fill {
        fill: #ffffff !important;
        stroke: #ffffff !important;
    }
    nav.apple-nav.apple-nav-dark .nav-brand-icon-svg path.cap-tassel {
        stroke: #ffffff !important;
    }
    nav.apple-nav.apple-nav-dark .nav-item {
        color: rgba(255, 255, 255, 0.8);
    }
    nav.apple-nav.apple-nav-dark .nav-item:hover {
        color: #ffffff !important;
        opacity: 1;
    }
    nav.apple-nav.apple-nav-dark .nav-item.active {
        color: #ffffff !important;
        font-weight: 600;
        opacity: 1;
    }
    nav.apple-nav.apple-nav-dark .nav-status-pill {
        background: rgba(52, 199, 89, 0.16);
        color: #7ee787;
        border: 1px solid rgba(52, 199, 89, 0.35);
    }

    /* 2. Apple Subpage Light Navigation (https://www.apple.com/tr/store) */
    nav.apple-nav.apple-nav-light {
        background: rgba(245, 245, 247, 0.85);
        backdrop-filter: saturate(180%) blur(20px);
        -webkit-backdrop-filter: saturate(180%) blur(20px);
        border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    }
    nav.apple-nav.apple-nav-light .nav-brand {
        color: #1d1d1f;
    }
    nav.apple-nav.apple-nav-light .nav-brand-icon-svg path.cap-fill {
        fill: #1d1d1f !important;
        stroke: #1d1d1f !important;
    }
    nav.apple-nav.apple-nav-light .nav-brand-icon-svg path.cap-tassel {
        stroke: #1d1d1f !important;
    }
    nav.apple-nav.apple-nav-light .nav-item {
        color: rgba(0, 0, 0, 0.72);
    }
    nav.apple-nav.apple-nav-light .nav-item:hover {
        color: #000000 !important;
        opacity: 1;
    }
    nav.apple-nav.apple-nav-light .nav-item.active {
        color: #000000 !important;
        font-weight: 600;
        opacity: 1;
    }
    nav.apple-nav.apple-nav-light .nav-status-pill {
        background: var(--status-green-bg);
        color: #1b5e20;
        border: 1px solid rgba(52, 199, 89, 0.25);
    }

    .apple-nav-inner {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 36px;
        width: 100%;
        max-width: 1040px;
        margin: 0 auto;
    }

    .nav-brand {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        font-weight: 500;
        font-size: 13.5px;
        letter-spacing: -0.02em;
        transition: opacity 0.2s ease;
    }

    .nav-brand:hover {
        opacity: 0.7;
    }

    .nav-brand-icon-svg {
        width: 18px;
        height: 18px;
        display: block;
        transition: transform 0.2s ease;
    }

    .nav-brand:hover .nav-brand-icon-svg {
        transform: scale(1.08);
    }

    .nav-items {
        display: flex;
        align-items: center;
        gap: 36px;
    }

    .nav-item {
        text-decoration: none;
        font-size: 13px;
        font-weight: 400;
        padding: 4px 6px;
        transition: color 0.15s ease, opacity 0.15s ease;
    }

    .nav-status-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 11.5px;
        font-weight: 500;
        padding: 3px 10px;
        border-radius: var(--radius-pill);
    }

    .status-pulse {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--status-green);
        box-shadow: 0 0 0 2px rgba(52, 199, 89, 0.25);
    }

    /* Page Header: Apple Tight Headline Cadence */
    .page-header {
        text-align: center;
        padding: 38px 0 28px;
    }

    .page-header .eyebrow {
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--ink-muted);
        margin-bottom: 8px;
        display: block;
    }

    .page-header h1 {
        font-size: 34px;
        font-weight: 700;
        letter-spacing: -0.03em;
        line-height: 1.12;
        color: var(--ink);
        margin-bottom: 8px;
    }

    .page-header p.subtitle {
        font-size: 16px;
        color: var(--ink-secondary);
        max-width: 620px;
        margin: 0 auto;
        line-height: 1.5;
        font-weight: 400;
    }

    /* Apple 18px Museum Tile Cards */
    .card {
        background: rgb(245, 245, 247);
        border: 1px solid rgba(0, 0, 0, 0.04);
        border-radius: 24px;
        padding: 30px 32px;
        box-shadow: 0 2px 14px rgba(0, 0, 0, 0.04);
        max-width: 1220px;
        margin-left: auto;
        margin-right: auto;
        margin-bottom: 28px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .card h2 {
        font-size: 19px;
        font-weight: 600;
        letter-spacing: -0.02em;
        color: var(--ink);
        margin-bottom: 18px;
        padding-bottom: 12px;
        border-bottom: 1px solid var(--hairline-soft);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    /* Buttons: Runway Solid Black & Apple Action Blue */
    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        font-family: inherit;
        font-size: 13.5px;
        font-weight: 500;
        padding: 9px 20px;
        border-radius: var(--radius-pill);
        border: 1px solid transparent;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.18s ease;
    }

    .btn-apple, .btn-primary {
        background: var(--apple-blue);
        color: white;
    }
    .btn-apple:hover, .btn-primary:hover {
        background: var(--apple-blue-hover);
        transform: translateY(-1px);
    }

    .btn-runway {
        background: var(--runway-black);
        color: white;
    }
    .btn-runway:hover {
        background: var(--runway-black-hover);
        transform: translateY(-1px);
    }

    .btn-secondary {
        background: rgba(0, 0, 0, 0.04);
        color: var(--ink);
        border: 1px solid transparent;
    }
    .btn-secondary:hover {
        background: rgba(0, 0, 0, 0.08);
    }

    .btn-outline {
        background: transparent;
        color: var(--apple-blue);
        border: 1px solid var(--apple-blue);
        transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .btn-outline:hover,
    .btn-outline:active,
    .btn-outline:focus {
        background: var(--apple-blue);
        color: #ffffff !important;
        border-color: var(--apple-blue);
        box-shadow: 0 4px 14px rgba(0, 113, 227, 0.25);
        transform: translateY(-1px);
    }

    .btn-danger {
        background: var(--status-red-bg);
        color: var(--status-red);
        border: 1px solid rgba(255, 59, 48, 0.2);
    }
    .btn-danger:hover {
        background: #fcdede;
    }

    /* Apple Link with Chevron */
    .link-chevron {
        color: var(--apple-blue);
        text-decoration: none;
        font-size: 13.5px;
        font-weight: 500;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        transition: gap 0.2s;
    }
    .link-chevron:hover {
        text-decoration: underline;
        gap: 7px;
    }

    /* Form Controls */
    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 16px;
    }
    .form-grid.grid-3 {
        grid-template-columns: repeat(3, 1fr);
    }
    .form-group {
        display: flex;
        flex-direction: column;
    }
    .form-group.full { grid-column: 1 / -1; }
    .form-group.span-2 { grid-column: span 2; }

    label {
        font-size: 12.5px;
        font-weight: 600;
        color: var(--ink-secondary);
        margin-bottom: 6px;
    }

    input, select, textarea {
        font-family: inherit;
        font-size: 14px;
        color: var(--ink);
        padding: 10px 14px;
        background: #ffffff;
        border: 1px solid rgba(0, 0, 0, 0.12);
        border-radius: var(--radius-sm);
        outline: none;
        transition: all 0.2s ease;
    }

    input:focus, select:focus, textarea:focus {
        background: var(--canvas);
        border-color: var(--apple-blue);
        box-shadow: 0 0 0 3px rgba(0, 113, 227, 0.15);
    }

    /* Minimalist Data Tables */
    .table-responsive {
        width: 100%;
        overflow-x: auto;
    }

    table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        margin-top: 6px;
    }

    th {
        background: var(--canvas-parchment);
        color: var(--ink-muted);
        font-size: 11.5px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        padding: 11px 14px;
        text-align: left;
        border-top: 1px solid var(--hairline-soft);
        border-bottom: 1px solid var(--hairline-soft);
    }

    th:first-child {
        border-top-left-radius: var(--radius-sm);
        border-bottom-left-radius: var(--radius-sm);
        border-left: 1px solid var(--hairline-soft);
    }

    th:last-child {
        border-top-right-radius: var(--radius-sm);
        border-bottom-right-radius: var(--radius-sm);
        border-right: 1px solid var(--hairline-soft);
    }

    td {
        padding: 13px 14px;
        font-size: 13.5px;
        color: var(--ink-secondary);
        border-bottom: 1px solid var(--hairline-soft);
        vertical-align: middle;
    }

    tr:hover td {
        background-color: rgba(0, 0, 0, 0.015);
    }

    /* Soft Museum Badges */
    .badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 3px 9px;
        border-radius: var(--radius-pill);
        font-size: 11.5px;
        font-weight: 600;
        letter-spacing: 0.02em;
    }

    .badge-users { background: var(--mod-users-bg); color: var(--mod-users-fg); }
    .badge-jobs { background: var(--mod-jobs-bg); color: var(--mod-jobs-fg); }
    .badge-apps { background: var(--mod-apps-bg); color: var(--mod-apps-fg); }
    .badge-announcements { background: var(--mod-announ-bg); color: var(--mod-announ-fg); }
    .badge-api { background: var(--mod-api-bg); color: var(--mod-api-fg); }

    .action-pill {
        padding: 5px 12px;
        border-radius: var(--radius-pill);
        font-size: 12px;
        font-weight: 500;
        text-decoration: none;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 3px;
        transition: all 0.15s ease;
    }
    .action-view { background: #e8f0fe; color: #1967d2; }
    .action-view:hover { background: #d2e3fc; }
    .action-edit { background: #fef7e0; color: #b06000; }
    .action-edit:hover { background: #feefc3; }
    .action-sub { background: #f3e8fd; color: #7b1fa2; }
    .action-sub:hover { background: #e8d0fb; }
    .action-delete { background: var(--status-red-bg); color: var(--status-red); }
    .action-delete:hover { background: #fcdede; }

    /* Footer: Apple Parchment Footer */
    footer.apple-footer {
        margin-top: auto;
        background: var(--canvas-parchment);
        border-top: 1px solid var(--hairline);
        padding: 32px 0 24px;
        font-size: 12px;
        color: var(--ink-muted);
    }

    .footer-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 16px;
    }

    .footer-nav {
        display: flex;
        gap: 18px;
    }

    .footer-nav a {
        color: var(--ink-secondary);
        text-decoration: none;
    }
    .footer-nav a:hover {
        color: var(--apple-blue);
    }

    @media (max-width: 768px) {
        .form-grid, .form-grid.grid-3 { grid-template-columns: 1fr; }
        .form-group.span-2 { grid-column: span 1; }
        .nav-items { display: none; }
    }
</style>
