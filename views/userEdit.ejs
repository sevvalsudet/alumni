<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= user.name %> - Kullanıcıyı Düzenle</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; background-color: #f4f6f9; color: #333; padding: 40px 20px; }
        .container { max-width: 600px; margin: 0 auto; }
        .card { background: white; border-radius: 10px; padding: 30px; box-shadow: 0 4px 10px rgba(0,0,0,0.08); }
        h1 { font-size: 22px; color: #2c3e50; margin-bottom: 20px; border-bottom: 2px solid #ecf0f1; padding-bottom: 12px; }
        .form-group { margin-bottom: 18px; display: flex; flex-direction: column; }
        label { font-size: 14px; font-weight: 600; color: #475569; margin-bottom: 6px; }
        input, select { padding: 10px 12px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 15px; outline: none; }
        input:focus, select:focus { border-color: #3498db; }
        .button-group { display: flex; gap: 10px; margin-top: 25px; }
        button.btn-save { background: #27ae60; color: white; border: none; padding: 12px 20px; border-radius: 6px; font-size: 15px; font-weight: bold; cursor: pointer; flex: 1; }
        button.btn-save:hover { background: #219653; }
        a.btn-cancel { background: #e2e8f0; color: #475569; padding: 12px 20px; border-radius: 6px; font-size: 15px; font-weight: 600; text-decoration: none; text-align: center; }
        a.btn-cancel:hover { background: #cbd5e1; }
    </style>
</head>
<body>
    <div class="container">
        <div class="card">
            <h1>✏️ Kullanıcı Bilgilerini Düzenle (ID #<%= user.id %>)</h1>
            
            <form action="/users/<%= user.id %>/update" method="POST">
                <div class="form-group">
                    <label for="name">Ad Soyad *</label>
                    <input type="text" id="name" name="name" value="<%= user.name %>" required>
                </div>

                <div class="form-group">
                    <label for="role">Rol *</label>
                    <select id="role" name="role" required>
                        <option value="Alumni" <%= user.role === 'Alumni' ? 'selected' : '' %>>Mezun (Alumni)</option>
                        <option value="Student" <%= user.role === 'Student' ? 'selected' : '' %>>Öğrenci (Student)</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="department">Bölüm</label>
                    <input type="text" id="department" name="department" value="<%= user.department || '' %>">
                </div>

                <div class="form-group">
                    <label for="company">Şirket</label>
                    <input type="text" id="company" name="company" value="<%= user.company || '' %>">
                </div>

                <div class="button-group">
                    <button type="submit" class="btn-save">Değişiklikleri Kaydet (Update)</button>
                    <a href="/users" class="btn-cancel">İptal</a>
                </div>
            </form>
        </div>
    </div>
</body>
</html>
