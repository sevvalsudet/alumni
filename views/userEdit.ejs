<!DOCTYPE html>
<html lang="tr">
<head>
    <%- include('partials/head', { title: 'Kullanıcı Düzenle • ' + user.name }) %>
    <style>
        .edit-container { max-width: 600px; margin: 0 auto; }
    </style>
</head>
<body>
    <%- include('partials/navbar', { active: 'users' }) %>

    <main class="container">
        <div class="edit-container">
            <div style="margin-bottom: 20px;">
                <a href="/users" style="color: var(--brand-primary); text-decoration: none; font-size: 14px; font-weight: 600;">← Mezun Listesine Dön</a>
            </div>

            <div class="card">
                <h2>
                    <span>✏️ Kullanıcı Profilini Düzenle</span>
                    <span class="badge badge-warning">ID #<%= user.id %></span>
                </h2>
                
                <form action="/users/<%= user.id %>/update" method="POST">
                    <div class="form-group" style="margin-bottom: 16px;">
                        <label for="name">Ad Soyad *</label>
                        <input type="text" id="name" name="name" value="<%= user.name %>" required>
                    </div>

                    <div class="form-group" style="margin-bottom: 16px;">
                        <label for="role">Sistem Rolü *</label>
                        <select id="role" name="role" required>
                            <option value="Alumni" <%= user.role === 'Alumni' ? 'selected' : '' %>>Mezun (Alumni)</option>
                            <option value="Student" <%= user.role === 'Student' ? 'selected' : '' %>>Öğrenci (Student)</option>
                        </select>
                    </div>

                    <div class="form-group" style="margin-bottom: 16px;">
                        <label for="department">Bölüm</label>
                        <input type="text" id="department" name="department" value="<%= user.department || '' %>" placeholder="Örn: Bilgisayar Mühendisliği">
                    </div>

                    <div class="form-group" style="margin-bottom: 24px;">
                        <label for="company">Şirket / Organizasyon</label>
                        <input type="text" id="company" name="company" value="<%= user.company || '' %>" placeholder="Örn: Google / Trendyol">
                    </div>

                    <div style="display: flex; gap: 12px;">
                        <button type="submit" class="btn btn-primary" style="flex: 2;">
                            Değişiklikleri Kaydet
                        </button>
                        <a href="/users" class="btn btn-secondary" style="flex: 1;">İptal</a>
                    </div>
                </form>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
