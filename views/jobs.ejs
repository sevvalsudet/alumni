<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>İş İlanları - Alumni Tracking System</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; background-color: #f4f6f9; color: #333; padding: 30px 20px; }
        .container { max-width: 1050px; margin: 0 auto; }
        
        /* Header */
        header { text-align: center; margin-bottom: 25px; }
        h1 { color: #2c3e50; font-size: 28px; margin-bottom: 8px; }
        p.subtitle { color: #7f8c8d; font-size: 15px; }

        /* Unified Navbar */
        .nav-bar { display: flex; justify-content: center; flex-wrap: wrap; gap: 8px; margin-bottom: 25px; background: white; padding: 12px 18px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); }
        .nav-bar a { color: #555; text-decoration: none; font-size: 14px; font-weight: 600; padding: 6px 14px; border-radius: 6px; transition: all 0.2s; }
        .nav-bar a:hover { background: #f0f4f8; color: #3498db; }
        .nav-bar a.active { background: #27ae60; color: white; }
        .nav-bar a.api-link { color: #27ae60; }
        .nav-bar a.doc-link { color: #8e44ad; }

        /* Card Layout */
        .card { background: white; border-radius: 8px; padding: 25px; box-shadow: 0 4px 6px rgba(0,0,0,0.06); margin-bottom: 25px; }
        h2 { font-size: 20px; color: #2c3e50; margin-bottom: 15px; border-bottom: 2px solid #ecf0f1; padding-bottom: 10px; display: flex; justify-content: space-between; align-items: center; }
        .badge-header { background: #27ae60; color: white; padding: 4px 10px; border-radius: 4px; font-size: 12px; font-weight: bold; }
        
        /* Form Styling */
        .form-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px; }
        .form-group { display: flex; flex-direction: column; }
        .form-group.full { grid-column: 1 / -1; }
        .form-group.span-2 { grid-column: span 2; }
        label { font-size: 13px; font-weight: 600; color: #555; margin-bottom: 5px; }
        input, select, textarea { padding: 10px 12px; border: 1px solid #dcdfe6; border-radius: 6px; font-size: 14px; outline: none; transition: border-color 0.2s; font-family: inherit; }
        input:focus, select:focus, textarea:focus { border-color: #27ae60; }
        textarea { resize: vertical; min-height: 70px; }
        button.btn-primary { background: #27ae60; color: white; border: none; padding: 12px 20px; border-radius: 6px; font-size: 15px; font-weight: bold; cursor: pointer; transition: background 0.2s; }
        button.btn-primary:hover { background: #219150; }

        /* Table Styling */
        table { width: 100%; border-collapse: collapse; margin-top: 10px; }
        th, td { padding: 12px 14px; text-align: left; border-bottom: 1px solid #edf2f7; font-size: 14px; vertical-align: middle; }
        th { background-color: #f8fafc; color: #475569; font-weight: 600; }
        tr:hover { background-color: #f8fafc; }

        /* Badges */
        .badge { display: inline-block; padding: 3px 8px; border-radius: 12px; font-size: 12px; font-weight: 600; }
        .badge-type { background: #e8f8f0; color: #27ae60; }
        .badge-level { background: #eaf2f8; color: #2980b9; }
        .badge-salary { background: #fef5e7; color: #d35400; font-weight: 700; }

        /* Action buttons */
        .actions { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; }
        a.btn-view { color: #3498db; text-decoration: none; font-weight: 600; padding: 5px 10px; border-radius: 4px; background: #ebf5fb; font-size: 13px; }
        a.btn-view:hover { background: #d4e6f1; }
        a.btn-apps { color: #8e44ad; text-decoration: none; font-weight: 600; padding: 5px 10px; border-radius: 4px; background: #f4ecf7; font-size: 13px; }
        a.btn-apps:hover { background: #e8daef; }
        button.btn-delete { background: #fee2e2; color: #dc2626; border: none; padding: 5px 10px; border-radius: 4px; font-size: 13px; font-weight: 600; cursor: pointer; }
        button.btn-delete:hover { background: #fecaca; }

        /* Banner */
        .nested-banner { background: #eafaf1; border-left: 4px solid #27ae60; padding: 14px 20px; margin-bottom: 20px; border-radius: 6px; font-size: 14px; color: #1e3a29; display: flex; justify-content: space-between; align-items: center; }
        .nested-banner a { color: #27ae60; font-weight: bold; text-decoration: none; }
        .empty { text-align: center; padding: 35px; color: #888; font-size: 15px; }

        @media (max-width: 768px) {
            .form-grid { grid-template-columns: 1fr; }
            .form-group.span-2 { grid-column: span 1; }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- HEADER -->
        <header>
            <h1>🎓 Alumni Tracking System</h1>
            <p class="subtitle">💼 İş İlanları & Kariyer Fırsatları (Career & Job Postings)</p>
        </header>

        <!-- UNIFIED NAVBAR -->
        <div class="nav-bar">
            <a href="/">🏠 Ana Sayfa</a>
            <a href="/users">👥 Kullanıcılar</a>
            <a href="/announcements">📢 Duyurular</a>
            <a href="/jobs" class="active">💼 İş İlanları</a>
            <a href="/applications">📝 Başvurular</a>
            <a href="/api/jobs" target="_blank" class="api-link">⚡ API (JSON)</a>
            <a href="/api/swagger" target="_blank" class="doc-link">📖 Swagger</a>
        </div>

        <% if (selectedUser) { %>
            <div class="nested-banner">
                <div>
                    <strong>🔗 Filtreli Görünüm:</strong> <strong><%= selectedUser.name %></strong> (#<%= selectedUser.id %>) tarafından yayınlanan ilanlar listeleniyor.
                </div>
                <a href="/jobs">← Tüm İlanları Göster</a>
            </div>
        <% } %>

        <!-- ➕ CREATE: POST /jobs Formu -->
        <div class="card">
            <h2>
                <span>➕ Yeni İş İlanı Yayınla</span>
                <span class="badge-header">[CREATE]</span>
            </h2>
            <form action="/jobs" method="POST">
                <div class="form-grid">
                    <div class="form-group span-2">
                        <label for="title">Pozisyon Başlığı *</label>
                        <input type="text" id="title" name="title" placeholder="Örn: Senior Backend Engineer" required>
                    </div>
                    <div class="form-group">
                        <label for="company">Şirket / Kurum *</label>
                        <input type="text" id="company" name="company" placeholder="Örn: Google, Trendyol" required>
                    </div>

                    <div class="form-group">
                        <label for="location">Konum *</label>
                        <input type="text" id="location" name="location" placeholder="Örn: Istanbul, TR / Remote" required>
                    </div>
                    <div class="form-group">
                        <label for="employment_type">Çalışma Şekli</label>
                        <select id="employment_type" name="employment_type">
                            <option value="Full-time">Tam Zamanlı (Full-time)</option>
                            <option value="Part-time">Yarı Zamanlı (Part-time)</option>
                            <option value="Contract">Sözleşmeli (Contract)</option>
                            <option value="Internship">Staj (Internship)</option>
                            <option value="Remote">Uzaktan (Remote)</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="experience_level">Deneyim Seviyesi</label>
                        <select id="experience_level" name="experience_level">
                            <option value="Entry-level">Başlangıç (Entry-level)</option>
                            <option value="Mid-level" selected>Orta (Mid-level)</option>
                            <option value="Senior">Kıdemli (Senior)</option>
                            <option value="Lead">Lider (Lead)</option>
                            <option value="Executive">Yönetici (Executive)</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="salary">Maaş (Yıllık / USD)</label>
                        <input type="number" step="0.01" id="salary" name="salary" placeholder="Örn: 95000">
                    </div>
                    <div class="form-group span-2">
                        <label for="posted_by">İlan Sahibi (Alumni / Admin) *</label>
                        <select id="posted_by" name="posted_by" required>
                            <% users.forEach(u => { %>
                                <option value="<%= u.id %>" <%= (selectedUser && selectedUser.id === u.id) ? 'selected' : '' %>>
                                    <%= u.name %> (<%= u.role %> - <%= u.department || 'General' %>)
                                </option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="form-group full">
                        <label for="description">İş Tanımı ve Sorumluluklar *</label>
                        <textarea id="description" name="description" placeholder="Rolün genel özeti, temel sorumluluklar..." required></textarea>
                    </div>

                    <div class="form-group full">
                        <label for="requirements">Gereksinimler & Nitelikler</label>
                        <textarea id="requirements" name="requirements" placeholder="Aranan teknolojiler, diller, deneyim şartları..."></textarea>
                    </div>

                    <div class="form-group">
                        <label for="contact_email">İletişim / Başvuru E-posta</label>
                        <input type="email" id="contact_email" name="contact_email" placeholder="jobs@company.com">
                    </div>
                    <div class="form-group">
                        <label for="application_url">Dış Başvuru Portalı Linki</label>
                        <input type="url" id="application_url" name="application_url" placeholder="https://careers.company.com">
                    </div>
                    <div class="form-group">
                        <label for="application_deadline">Son Başvuru Tarihi</label>
                        <input type="date" id="application_deadline" name="application_deadline">
                    </div>

                    <div class="form-group full">
                        <button type="submit" class="btn-primary">💼 İlanı Yayınla (POST /jobs)</button>
                    </div>
                </div>
            </form>
        </div>

        <!-- 📖 READ: GET /jobs Listeleme -->
        <div class="card">
            <h2>
                <span>📋 Güncel İş ve Staj İlanları (<%= jobs.length %>)</span>
                <span class="badge-header">[READ / DELETE]</span>
            </h2>

            <% if (jobs.length === 0) { %>
                <div class="empty">
                    <p>📭 Henüz kayıtlı bir iş ilanı bulunmamaktadır. Yukarıdaki formdan ilk ilanı ekleyebilirsiniz!</p>
                </div>
            <% } else { %>
                <table>
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Pozisyon & Şirket</th>
                            <th>Konum</th>
                            <th>Tür & Seviye</th>
                            <th>Maaş</th>
                            <th>İlan Sahibi</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% jobs.forEach(job => { %>
                            <tr>
                                <td><strong>#<%= job.id %></strong></td>
                                <td>
                                    <strong><%= job.title %></strong><br>
                                    <span style="color: #666; font-size: 13px;">🏢 <%= job.company %></span>
                                </td>
                                <td>📍 <%= job.location %></td>
                                <td>
                                    <span class="badge badge-type"><%= job.employment_type %></span>
                                    <span class="badge badge-level"><%= job.experience_level %></span>
                                </td>
                                <td>
                                    <% if (job.salary) { %>
                                        <span class="badge badge-salary">$<%= Number(job.salary).toLocaleString() %></span>
                                    <% } else { %>
                                        <span style="color: #aaa; font-size: 12px;">Belirtilmedi</span>
                                    <% } %>
                                </td>
                                <td>
                                    <a href="/users/<%= job.posted_by %>/jobs" style="color: #3498db; text-decoration: none; font-weight: 500;">
                                        👤 <%= job.posted_by_name || 'Üye #' + job.posted_by %>
                                    </a>
                                </td>
                                <td class="actions">
                                    <a href="/jobs/<%= job.id %>" class="btn-view">👁 Detay</a>
                                    <a href="/jobs/<%= job.id %>/applications" class="btn-apps">📝 Başvurular</a>
                                    <form action="/jobs/<%= job.id %>/delete" method="POST" style="display:inline"
                                          onsubmit="return confirm('Bu iş ilanını silmek istediğinize emin misiniz?')">
                                        <button type="submit" class="btn-delete">Sil</button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            <% } %>
        </div>
    </div>
</body>
</html>
