<!DOCTYPE html>
<html lang="tr">
<head>
    <%- include('partials/head', { title: 'İş & Staj İlanları • Alumni.io' }) %>
    <style>
        .filter-banner {
            background: var(--jobs-surface);
            border: 1px solid #bbf7d0;
            padding: 14px 20px;
            border-radius: var(--radius-md);
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            color: #166534;
            font-size: 14px;
        }
    </style>
</head>
<body>
    <%- include('partials/navbar', { active: 'jobs' }) %>

    <main class="container">
        <div class="page-header">
            <h1>💼 Kariyer & İş İlanları</h1>
            <p class="subtitle">Mezun ve iş ortakları tarafından paylaşılan açık pozisyonları inceleyin veya yeni bir fırsat yayınlayın.</p>
        </div>

        <% if (selectedUser) { %>
            <div class="filter-banner">
                <div>
                    <strong>🔗 Filtreli Görünüm:</strong> <strong><%= selectedUser.name %></strong> (#<%= selectedUser.id %>) tarafından yayınlanan ilanlar listeleniyor.
                </div>
                <a href="/jobs" class="btn btn-secondary" style="padding: 6px 14px; font-size: 12.5px;">Tüm İlanları Göster</a>
            </div>
        <% } %>

        <!-- ➕ CREATE: POST /jobs Formu -->
        <div class="card">
            <h2>
                <span>➕ Yeni İş İlanı Yayınla</span>
                <span class="badge badge-jobs">CREATE</span>
            </h2>
            <form action="/jobs" method="POST">
                <div class="form-grid grid-3">
                    <div class="form-group span-2">
                        <label for="title">Pozisyon Başlığı *</label>
                        <input type="text" id="title" name="title" placeholder="Örn: Senior Full Stack Engineer" required maxlength="120">
                    </div>
                    <div class="form-group">
                        <label for="company">Şirket / Organizasyon *</label>
                        <input type="text" id="company" name="company" placeholder="Örn: Google / Trendyol" required>
                    </div>

                    <div class="form-group">
                        <label for="location">Konum / Şehir</label>
                        <input type="text" id="location" name="location" placeholder="Örn: İstanbul, TR / Remote">
                    </div>
                    <div class="form-group">
                        <label for="employment_type">Çalışma Şekli</label>
                        <select id="employment_type" name="employment_type">
                            <option value="Full-time">Tam Zamanlı (Full-time)</option>
                            <option value="Part-time">Yarı Zamanlı (Part-time)</option>
                            <option value="Contract">Sözleşmeli (Contract)</option>
                            <option value="Internship">Staj (Internship)</option>
                            <option value="Remote">Uzaktan (Remote)</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="experience_level">Deneyim Seviyesi</label>
                        <select id="experience_level" name="experience_level">
                            <option value="Entry-level">Başlangıç (Entry-level)</option>
                            <option value="Mid-level" selected>Orta (Mid-level)</option>
                            <option value="Senior">Kıdemli (Senior)</option>
                            <option value="Lead">Lider (Lead)</option>
                            <option value="Executive">Yönetici (Executive)</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="salary">Tahmini Maaş (USD / Yıllık)</label>
                        <input type="number" step="0.01" id="salary" name="salary" placeholder="Örn: 90000">
                    </div>
                    <div class="form-group span-2">
                        <label for="posted_by">İlan Sahibi (Alumni / Üye) *</label>
                        <select id="posted_by" name="posted_by" required>
                            <% users.forEach(u => { %>
                                <option value="<%= u.id %>" <%= (selectedUser && selectedUser.id === u.id) ? 'selected' : '' %>>
                                    <%= u.name %> (<%= u.role %> - <%= u.department || 'Genel' %>)
                                </option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="form-group full">
                        <label for="description">İş Tanımı ve Kapsamı</label>
                        <textarea id="description" name="description" placeholder="Rolün genel sorumlulukları ve iş tanımı..."></textarea>
                    </div>

                    <div class="form-group full">
                        <label for="requirements">Gereksinimler & Nitelikler</label>
                        <textarea id="requirements" name="requirements" placeholder="Teknolojiler, yetkinlikler ve aranan tecrübe..."></textarea>
                    </div>

                    <div class="form-group">
                        <label for="contact_email">İletişim E-posta</label>
                        <input type="email" id="contact_email" name="contact_email" placeholder="hr@sirket.com">
                    </div>
                    <div class="form-group">
                        <label for="application_url">Dış Başvuru Bağlantısı</label>
                        <input type="url" id="application_url" name="application_url" placeholder="https://careers.sirket.com">
                    </div>
                    <div class="form-group">
                        <label for="application_deadline">Son Başvuru Tarihi</label>
                        <input type="date" id="application_deadline" name="application_deadline">
                    </div>

                    <div class="form-group full" style="margin-top: 10px;">
                        <button type="submit" class="btn btn-primary" style="width: 100%;">
                            <span>İlanı Yayınla</span>
                            <span>→</span>
                        </button>
                    </div>
                </div>
            </form>
        </div>

        <!-- 📖 READ: GET /jobs Listeleme -->
        <div class="card">
            <h2>
                <span>📋 Güncel İş ve Staj İlanları</span>
                <span class="badge badge-jobs"><%= jobs.length %> İlan</span>
            </h2>

            <% if (jobs.length === 0) { %>
                <div style="text-align: center; color: var(--stone); padding: 40px 20px;">
                    📭 Henüz kayıtlı bir iş ilanı bulunmamaktadır. İlk ilanı yukarıdaki formdan oluşturabilirsiniz!
                </div>
            <% } else { %>
                <div class="table-responsive">
                    <table>
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Pozisyon & Şirket</th>
                                <th>Konum</th>
                                <th>Tür & Seviye</th>
                                <th>Maaş</th>
                                <th>İlan Sahibi</th>
                                <th style="text-align: right;">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% jobs.forEach(job => { %>
                                <tr>
                                    <td><strong style="color: var(--ink);">#<%= job.id %></strong></td>
                                    <td>
                                        <div style="font-weight: 700; color: var(--ink);"><%= job.title %></div>
                                        <div style="font-size: 13px; color: var(--stone);">🏢 <%= job.company %></div>
                                    </td>
                                    <td><%= job.location || '—' %></td>
                                    <td>
                                        <div style="display: flex; gap: 4px; flex-wrap: wrap;">
                                            <span class="badge badge-jobs"><%= job.employment_type %></span>
                                            <span class="badge badge-primary"><%= job.experience_level %></span>
                                        </div>
                                    </td>
                                    <td>
                                        <% if (job.salary) { %>
                                            <span class="badge badge-warning">$<%= Number(job.salary).toLocaleString() %></span>
                                        <% } else { %>
                                            <span style="color: var(--stone); font-size: 13px;">—</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <a href="/users/<%= job.posted_by %>/jobs" style="color: var(--brand-primary); text-decoration: none; font-weight: 600; font-size: 13px;">
                                            👤 <%= job.posted_by_name || 'Üye #' + job.posted_by %>
                                        </a>
                                    </td>
                                    <td style="text-align: right;">
                                        <div class="table-actions" style="justify-content: flex-end;">
                                            <a href="/jobs/<%= job.id %>" class="action-pill action-view">Detay</a>
                                            <a href="/jobs/<%= job.id %>/applications" class="action-pill action-sub">Başvurular</a>
                                            <form action="/jobs/<%= job.id %>/delete" method="POST" style="display:inline"
                                                  onsubmit="return confirm('Bu iş ilanını silmek istediğinize emin misiniz?')">
                                                <button type="submit" class="action-pill action-delete">Sil</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
