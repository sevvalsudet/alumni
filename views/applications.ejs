<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>İş Başvuruları - Alumni Tracking System</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; background-color: #f4f6f9; color: #333; padding: 30px 20px; }
        .container { max-width: 1050px; margin: 0 auto; }
        
        /* Header */
        header { text-align: center; margin-bottom: 25px; }
        h1 { color: #2c3e50; font-size: 28px; margin-bottom: 8px; }
        p.subtitle { color: #7f8c8d; font-size: 15px; }

        /* Unified Navbar */
        .nav-bar { display: flex; justify-content: center; flex-wrap: wrap; gap: 8px; margin-bottom: 25px; background: white; padding: 12px 18px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); }
        .nav-bar a { color: #555; text-decoration: none; font-size: 14px; font-weight: 600; padding: 6px 14px; border-radius: 6px; transition: all 0.2s; }
        .nav-bar a:hover { background: #f0f4f8; color: #8e44ad; }
        .nav-bar a.active { background: #8e44ad; color: white; }
        .nav-bar a.api-link { color: #8e44ad; }
        .nav-bar a.doc-link { color: #27ae60; }

        /* Card Layout */
        .card { background: white; border-radius: 8px; padding: 25px; box-shadow: 0 4px 6px rgba(0,0,0,0.06); margin-bottom: 25px; }
        h2 { font-size: 20px; color: #2c3e50; margin-bottom: 15px; border-bottom: 2px solid #ecf0f1; padding-bottom: 10px; display: flex; justify-content: space-between; align-items: center; }
        .badge-header { background: #8e44ad; color: white; padding: 4px 10px; border-radius: 4px; font-size: 12px; font-weight: bold; }
        
        /* Form Styling */
        .form-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px; }
        .form-group { display: flex; flex-direction: column; }
        .form-group.full { grid-column: 1 / -1; }
        label { font-size: 13px; font-weight: 600; color: #555; margin-bottom: 5px; }
        input, select, textarea { padding: 10px 12px; border: 1px solid #dcdfe6; border-radius: 6px; font-size: 14px; outline: none; transition: border-color 0.2s; font-family: inherit; }
        input:focus, select:focus, textarea:focus { border-color: #8e44ad; }
        textarea { resize: vertical; min-height: 70px; }
        button.btn-primary { background: #8e44ad; color: white; border: none; padding: 12px 20px; border-radius: 6px; font-size: 15px; font-weight: bold; cursor: pointer; transition: background 0.2s; }
        button.btn-primary:hover { background: #732d91; }

        /* Table Styling */
        table { width: 100%; border-collapse: collapse; margin-top: 10px; }
        th, td { padding: 12px 14px; text-align: left; border-bottom: 1px solid #edf2f7; font-size: 14px; vertical-align: middle; }
        th { background-color: #f8fafc; color: #475569; font-weight: 600; }
        tr:hover { background-color: #f8fafc; }

        /* Status Badges */
        .badge { display: inline-block; padding: 4px 10px; border-radius: 12px; font-size: 12px; font-weight: 600; }
        .badge-pending { background: #fef9e7; color: #d97706; }
        .badge-reviewed { background: #ebf5fb; color: #2563eb; }
        .badge-interviewing { background: #f5eef8; color: #7c3aed; }
        .badge-accepted { background: #dcfce7; color: #15803d; }
        .badge-rejected { background: #fee2e2; color: #dc2626; }

        /* Action buttons */
        .actions { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; }
        a.btn-view { color: #3498db; text-decoration: none; font-weight: 600; padding: 5px 10px; border-radius: 4px; background: #ebf5fb; font-size: 13px; }
        a.btn-view:hover { background: #d4e6f1; }
        button.btn-delete { background: #fee2e2; color: #dc2626; border: none; padding: 5px 10px; border-radius: 4px; font-size: 13px; font-weight: 600; cursor: pointer; }
        button.btn-delete:hover { background: #fecaca; }

        /* Banner */
        .nested-banner { background: #f4ecf7; border-left: 4px solid #8e44ad; padding: 14px 20px; margin-bottom: 20px; border-radius: 6px; font-size: 14px; color: #4a235a; display: flex; justify-content: space-between; align-items: center; }
        .nested-banner a { color: #8e44ad; font-weight: bold; text-decoration: none; }
        .empty { text-align: center; padding: 35px; color: #888; font-size: 15px; }

        @media (max-width: 768px) {
            .form-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- HEADER -->
        <header>
            <h1>🎓 Alumni Tracking System</h1>
            <p class="subtitle">📝 İş Başvuruları & Değerlendirme Takibi (Job Applications Management)</p>
        </header>

        <!-- UNIFIED NAVBAR -->
        <div class="nav-bar">
            <a href="/">🏠 Ana Sayfa</a>
            <a href="/users">👥 Kullanıcılar</a>
            <a href="/announcements">📢 Duyurular</a>
            <a href="/jobs">💼 İş İlanları</a>
            <a href="/applications" class="active">📝 Başvurular</a>
            <a href="/api/applications" target="_blank" class="api-link">⚡ API (JSON)</a>
            <a href="/api/swagger" target="_blank" class="doc-link">📖 Swagger</a>
        </div>

        <% if (filterType === 'job' && filterTarget) { %>
            <div class="nested-banner">
                <div>
                    <strong>🔗 Filtreli Görünüm (İlana Gelen Başvurular):</strong> 
                    <strong><%= filterTarget.title %></strong> - <strong><%= filterTarget.company %></strong> (#<%= filterTarget.id %>) için başvurular listeleniyor.
                </div>
                <a href="/applications">← Tüm Başvuruları Göster</a>
            </div>
        <% } else if (filterType === 'user' && filterTarget) { %>
            <div class="nested-banner">
                <div>
                    <strong>🔗 Filtreli Görünüm (Adayın Başvuruları):</strong> 
                    <strong><%= filterTarget.name %></strong> (#<%= filterTarget.id %>) tarafından yapılan başvurular listeleniyor.
                </div>
                <a href="/applications">← Tüm Başvuruları Göster</a>
            </div>
        <% } %>

        <!-- ➕ CREATE: POST /applications Formu -->
        <div class="card">
            <h2>
                <span>➕ Yeni İş Başvurusu Gönder</span>
                <span class="badge-header">[CREATE]</span>
            </h2>
            <form action="/applications" method="POST">
                <div class="form-grid">
                    <div class="form-group">
                        <label for="job_id">Başvurulacak İlan *</label>
                        <select id="job_id" name="job_id" required>
                            <% jobs.forEach(j => { %>
                                <option value="<%= j.id %>" <%= (filterType === 'job' && filterTarget && filterTarget.id === j.id) ? 'selected' : '' %>>
                                    #<%= j.id %> - <%= j.title %> (<%= j.company %>)
                                </option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="user_id">Başvuran Kullanıcı (Aday) *</label>
                        <select id="user_id" name="user_id" required>
                            <% users.forEach(u => { %>
                                <option value="<%= u.id %>" <%= (filterType === 'user' && filterTarget && filterTarget.id === u.id) ? 'selected' : '' %>>
                                    <%= u.name %> (<%= u.role %> - <%= u.department || 'General' %>)
                                </option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="resume_url">Özgeçmiş / CV Linki</label>
                        <input type="url" id="resume_url" name="resume_url" placeholder="https://example.com/resumes/cv.pdf">
                    </div>

                    <div class="form-group full">
                        <label for="cover_letter">Ön Yazı / Motivasyon Notu</label>
                        <textarea id="cover_letter" name="cover_letter" placeholder="Adayın yetenekleri, projeleri ve başvuru motivasyonu..."></textarea>
                    </div>

                    <div class="form-group full">
                        <button type="submit" class="btn-primary">🚀 Başvuruyu Gönder (POST /applications)</button>
                    </div>
                </div>
            </form>
        </div>

        <!-- 📖 READ: GET /applications Listeleme -->
        <div class="card">
            <h2>
                <span>📋 Başvurular Listesi (<%= applications.length %>)</span>
                <span class="badge-header">[READ / DELETE]</span>
            </h2>

            <% if (applications.length === 0) { %>
                <div class="empty">
                    <p>📭 Bu kritere uygun kayıtlı bir başvuru bulunmamaktadır.</p>
                </div>
            <% } else { %>
                <table>
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Hedef İlan & Şirket</th>
                            <th>Başvuran Aday</th>
                            <th>Durum</th>
                            <th>Başvuru Tarihi</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% applications.forEach(app => { %>
                            <tr>
                                <td><strong>#<%= app.id %></strong></td>
                                <td>
                                    <a href="/jobs/<%= app.job_id %>" style="color: #2c3e50; font-weight: bold; text-decoration: none;">
                                        💼 <%= app.job_title %>
                                    </a><br>
                                    <span style="color: #64748b; font-size: 13px;">🏢 <%= app.job_company %></span>
                                </td>
                                <td>
                                    <a href="/users/<%= app.user_id %>" style="color: #2980b9; font-weight: bold; text-decoration: none;">
                                        👤 <%= app.applicant_name %>
                                    </a><br>
                                    <span style="color: #777; font-size: 12px;"><%= app.applicant_email %></span>
                                </td>
                                <td>
                                    <% 
                                        let badgeClass = 'badge-pending';
                                        if (app.status === 'Reviewed') badgeClass = 'badge-reviewed';
                                        else if (app.status === 'Interviewing') badgeClass = 'badge-interviewing';
                                        else if (app.status === 'Accepted') badgeClass = 'badge-accepted';
                                        else if (app.status === 'Rejected') badgeClass = 'badge-rejected';
                                    %>
                                    <span class="badge <%= badgeClass %>"><%= app.status %></span>
                                </td>
                                <td style="color: #666; font-size: 13px;">
                                    <%= String(app.applied_at).split('T')[0] %>
                                </td>
                                <td class="actions">
                                    <a href="/applications/<%= app.id %>" class="btn-view">👁 İncele</a>
                                    <form action="/applications/<%= app.id %>/delete" method="POST" style="display:inline"
                                          onsubmit="return confirm('Bu başvuruyu silmek istediğinize emin misiniz?')">
                                        <button type="submit" class="btn-delete">Sil</button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            <% } %>
        </div>
    </div>
</body>
</html>
