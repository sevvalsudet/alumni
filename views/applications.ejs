<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Job Applications - Alumni Tracking System</title>
    <style>
        body { font-family: Arial, sans-serif; max-width: 1100px; margin: 40px auto; padding: 0 20px; background: #f4f6f9; }
        h1 { color: #2c3e50; border-bottom: 3px solid #8e44ad; padding-bottom: 10px; }
        .nav { margin-bottom: 20px; }
        .nav a { margin-right: 15px; color: #3498db; text-decoration: none; font-weight: bold; }
        .nav a:hover { text-decoration: underline; }
        table { width: 100%; border-collapse: collapse; background: white; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
        th { background: #8e44ad; color: white; padding: 12px; text-align: left; }
        td { padding: 12px; border-bottom: 1px solid #eee; }
        tr:hover { background: #faf8fc; }
        .badge { display: inline-block; padding: 4px 10px; border-radius: 12px; font-size: 12px; font-weight: bold; }
        .badge-pending { background: #fef9e7; color: #f39c12; border: 1px solid #f9e79f; }
        .badge-reviewed { background: #ebf5fb; color: #2980b9; border: 1px solid #aed6f1; }
        .badge-interviewing { background: #f5eef8; color: #8e44ad; border: 1px solid #d7bde2; }
        .badge-accepted { background: #eafaf1; color: #27ae60; border: 1px solid #a9dfbf; }
        .badge-rejected { background: #fdedec; color: #e74c3c; border: 1px solid #f5b7b1; }
        .actions a { margin-right: 8px; padding: 5px 10px; border-radius: 4px; text-decoration: none; font-size: 13px; font-weight: bold; }
        .btn-view { background: #3498db; color: white; }
        .btn-delete { background: #e74c3c; color: white; border: none; cursor: pointer; padding: 5px 10px; border-radius: 4px; font-size: 13px; font-weight: bold; }
        .create-form { background: white; padding: 25px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); margin-bottom: 30px; }
        .create-form h2 { color: #8e44ad; margin-top: 0; }
        .form-row { display: flex; gap: 15px; flex-wrap: wrap; }
        .form-group { flex: 1; min-width: 240px; margin-bottom: 12px; }
        .form-group label { display: block; font-weight: bold; color: #555; margin-bottom: 5px; font-size: 13px; }
        .form-group input, .form-group textarea, .form-group select {
            width: 100%; padding: 9px; border: 1px solid #ddd; border-radius: 4px; box-sizing: border-box; font-size: 14px;
        }
        .form-group textarea { resize: vertical; min-height: 80px; }
        .btn-create { background: #8e44ad; color: white; border: none; padding: 10px 22px; border-radius: 4px; cursor: pointer; font-size: 15px; font-weight: bold; }
        .btn-create:hover { background: #732d91; }
        .empty { text-align: center; padding: 40px; color: #888; background: white; border-radius: 8px; box-shadow: 0 2px 6px rgba(0,0,0,0.05); }
        .nested-banner { background: #f4ecf7; border-left: 4px solid #8e44ad; padding: 14px 20px; margin-bottom: 20px; border-radius: 4px; font-size: 15px; }
        .nested-banner a { color: #8e44ad; font-weight: bold; margin-left: 15px; }
    </style>
</head>
<body>
    <div class="nav">
        <a href="/">🏠 Ana Sayfa</a>
        <a href="/users">👥 Users</a>
        <a href="/announcements">📢 Announcements</a>
        <a href="/jobs">💼 Job Postings</a>
        <a href="/applications" style="color: #8e44ad;">📝 Applications</a>
        <a href="/api/applications" target="_blank">⚡ API (JSON)</a>
        <a href="/api/swagger" target="_blank">📖 Swagger</a>
    </div>

    <% if (filterType === 'job' && filterTarget) { %>
        <div class="nested-banner">
            <strong>🔗 Nested View:</strong> Showing candidate applications received for job: <strong><%= filterTarget.title %></strong> at <strong><%= filterTarget.company %></strong> (#<%= filterTarget.id %>).
            <a href="/applications">← Show All Applications</a>
        </div>
        <h1>📝 Applications for: <%= filterTarget.title %></h1>
    <% } else if (filterType === 'user' && filterTarget) { %>
        <div class="nested-banner">
            <strong>🔗 Nested View:</strong> Showing all job applications submitted by: <strong><%= filterTarget.name %></strong> (#<%= filterTarget.id %>).
            <a href="/applications">← Show All Applications</a>
        </div>
        <h1>📝 Applications by <%= filterTarget.name %></h1>
    <% } else { %>
        <h1>📝 Candidate Job Applications</h1>
    <% } %>

    <!-- CREATE FORM -->
    <div class="create-form">
        <h2>➕ Submit a New Job Application</h2>
        <form action="/applications" method="POST">
            <div class="form-row">
                <div class="form-group">
                    <label for="job_id">Select Job Opportunity *</label>
                    <select id="job_id" name="job_id" required>
                        <% jobs.forEach(j => { %>
                            <option value="<%= j.id %>" <%= (filterType === 'job' && filterTarget && filterTarget.id === j.id) ? 'selected' : '' %>>
                                #<%= j.id %> - <%= j.title %> (<%= j.company %>)
                            </option>
                        <% }) %>
                    </select>
                </div>
                <div class="form-group">
                    <label for="user_id">Select Applicant (Alumni / Student) *</label>
                    <select id="user_id" name="user_id" required>
                        <% users.forEach(u => { %>
                            <option value="<%= u.id %>" <%= (filterType === 'user' && filterTarget && filterTarget.id === u.id) ? 'selected' : '' %>>
                                <%= u.name %> (<%= u.role %> - <%= u.department %>)
                            </option>
                        <% }) %>
                    </select>
                </div>
                <div class="form-group">
                    <label for="resume_url">Resume / Portfolio URL</label>
                    <input type="url" id="resume_url" name="resume_url" placeholder="https://example.com/resumes/my-cv.pdf">
                </div>
            </div>

            <div class="form-group">
                <label for="cover_letter">Cover Letter / Note to Recruiter</label>
                <textarea id="cover_letter" name="cover_letter" placeholder="Explain your motivation, relevant experience, and key skills for this position..."></textarea>
            </div>

            <button type="submit" class="btn-create">🚀 Submit Application</button>
        </form>
    </div>

    <!-- APPLICATIONS TABLE -->
    <% if (applications.length === 0) { %>
        <div class="empty">
            <p>📭 No applications found for this criteria.</p>
        </div>
    <% } else { %>
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Target Opportunity</th>
                    <th>Applicant</th>
                    <th>Status</th>
                    <th>Applied Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% applications.forEach(app => { %>
                    <tr>
                        <td><strong>#<%= app.id %></strong></td>
                        <td>
                            <a href="/jobs/<%= app.job_id %>" style="color: #2c3e50; font-weight: bold; text-decoration: none;">
                                💼 <%= app.job_title %>
                            </a><br>
                            <span style="color: #666; font-size: 13px;">🏢 <%= app.job_company %></span>
                            <a href="/jobs/<%= app.job_id %>/applications" style="font-size: 11px; color: #8e44ad; margin-left: 6px;">[All candidates]</a>
                        </td>
                        <td>
                            <a href="/users/<%= app.user_id %>" style="color: #2980b9; font-weight: bold; text-decoration: none;">
                                👤 <%= app.applicant_name %>
                            </a><br>
                            <span style="color: #777; font-size: 12px;"><%= app.applicant_email %></span>
                            <a href="/users/<%= app.user_id %>/applications" style="font-size: 11px; color: #8e44ad; margin-left: 6px;">[User history]</a>
                        </td>
                        <td>
                            <% 
                                let badgeClass = 'badge-pending';
                                if (app.status === 'Reviewed') badgeClass = 'badge-reviewed';
                                else if (app.status === 'Interviewing') badgeClass = 'badge-interviewing';
                                else if (app.status === 'Accepted') badgeClass = 'badge-accepted';
                                else if (app.status === 'Rejected') badgeClass = 'badge-rejected';
                            %>
                            <span class="badge <%= badgeClass %>"><%= app.status %></span>
                        </td>
                        <td style="color: #666; font-size: 13px;">
                            <%= String(app.applied_at).split('T')[0] %>
                        </td>
                        <td class="actions">
                            <a href="/applications/<%= app.id %>" class="btn-view">👁 Review</a>
                            <form action="/applications/<%= app.id %>/delete" method="POST" style="display:inline"
                                  onsubmit="return confirm('Are you sure you want to withdraw/delete this application?')">
                                <button type="submit" class="btn-delete">🗑 Delete</button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    <% } %>
</body>
</html>
