<!DOCTYPE html>
<html lang="tr">
<head>
    <%- include('partials/head', { title: 'İş Başvuruları & Değerlendirme • Alumni.io' }) %>
    <style>
        .filter-banner {
            background: var(--apps-surface);
            border: 1px solid #ddd6fe;
            padding: 14px 20px;
            border-radius: var(--radius-md);
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            color: #6b21a8;
            font-size: 14px;
        }
    </style>
</head>
<body>
    <%- include('partials/navbar', { active: 'applications' }) %>

    <main class="container">
        <div class="page-header">
            <h1>📝 Başvuru & Değerlendirme Takibi</h1>
            <p class="subtitle">Adayların açık pozisyonlara yaptığı başvuruları, değerlendirme durumlarını ve ön yazılarını yönetin.</p>
        </div>

        <% if (filterType === 'job' && filterTarget) { %>
            <div class="filter-banner">
                <div>
                    <strong>🔗 İlan Bazlı Filtre:</strong> 
                    <strong><%= filterTarget.title %></strong> (🏢 <%= filterTarget.company %>, #<%= filterTarget.id %>) için başvurular gösteriliyor.
                </div>
                <a href="/applications" class="btn btn-secondary" style="padding: 6px 14px; font-size: 12.5px;">Tüm Başvuruları Göster</a>
            </div>
        <% } else if (filterType === 'user' && filterTarget) { %>
            <div class="filter-banner">
                <div>
                    <strong>🔗 Aday Bazlı Filtre:</strong> 
                    <strong><%= filterTarget.name %></strong> (#<%= filterTarget.id %>) tarafından yapılan başvurular gösteriliyor.
                </div>
                <a href="/applications" class="btn btn-secondary" style="padding: 6px 14px; font-size: 12.5px;">Tüm Başvuruları Göster</a>
            </div>
        <% } %>

        <!-- ➕ CREATE: POST /applications Formu -->
        <div class="card">
            <h2>
                <span>➕ Yeni Başvuru Gönder</span>
                <span class="badge badge-apps">CREATE</span>
            </h2>
            <form action="/applications" method="POST">
                <div class="form-grid grid-3">
                    <div class="form-group">
                        <label for="job_id">Başvurulacak İlan *</label>
                        <select id="job_id" name="job_id" required>
                            <% jobs.forEach(j => { %>
                                <option value="<%= j.id %>" <%= (filterType === 'job' && filterTarget && filterTarget.id === j.id) ? 'selected' : '' %>>
                                    #<%= j.id %> - <%= j.title %> (<%= j.company %>)
                                </option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="user_id">Başvuran Aday *</label>
                        <select id="user_id" name="user_id" required>
                            <% users.forEach(u => { %>
                                <option value="<%= u.id %>" <%= (filterType === 'user' && filterTarget && filterTarget.id === u.id) ? 'selected' : '' %>>
                                    <%= u.name %> (<%= u.role %> - <%= u.department || 'Genel' %>)
                                </option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="resume_url">Özgeçmiş / Portfolyo Linki</label>
                        <input type="url" id="resume_url" name="resume_url" placeholder="https://example.com/cv.pdf">
                    </div>

                    <div class="form-group full">
                        <label for="cover_letter">Ön Yazı / Motivasyon Mektubu</label>
                        <textarea id="cover_letter" name="cover_letter" placeholder="Adayın nitelikleri, başarıları ve başvuru motivasyonu..."></textarea>
                    </div>

                    <div class="form-group full" style="margin-top: 8px;">
                        <button type="submit" class="btn btn-primary" style="background: var(--apps-accent); width: 100%;">
                            <span>Başvuruyu Sisteme Kaydet</span>
                            <span>→</span>
                        </button>
                    </div>
                </div>
            </form>
        </div>

        <!-- 📖 READ: GET /applications Listeleme -->
        <div class="card">
            <h2>
                <span>📋 Tüm Başvuru Süreçleri</span>
                <span class="badge badge-apps"><%= applications.length %> Başvuru</span>
            </h2>

            <% if (applications.length === 0) { %>
                <div style="text-align: center; color: var(--stone); padding: 35px 20px;">
                    📭 Bu kritere uygun kayıtlı bir başvuru bulunmamaktadır.
                </div>
            <% } else { %>
                <div class="table-responsive">
                    <table>
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Hedef Pozisyon & Şirket</th>
                                <th>Aday Bilgisi</th>
                                <th>Aşama / Durum</th>
                                <th>Başvuru Tarihi</th>
                                <th style="text-align: right;">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% applications.forEach(app => { %>
                                <tr>
                                    <td><strong style="color: var(--ink);">#<%= app.id %></strong></td>
                                    <td>
                                        <a href="/jobs/<%= app.job_id %>" style="color: var(--ink); font-weight: 700; text-decoration: none;">
                                            💼 <%= app.job_title %>
                                        </a>
                                        <div style="font-size: 13px; color: var(--stone);">🏢 <%= app.job_company %></div>
                                    </td>
                                    <td>
                                        <a href="/users/<%= app.user_id %>" style="color: var(--brand-primary); font-weight: 600; text-decoration: none;">
                                            👤 <%= app.applicant_name %>
                                        </a>
                                        <div style="font-size: 12px; color: var(--stone);"><%= app.applicant_email %></div>
                                    </td>
                                    <td>
                                        <% 
                                            let badgeStyle = 'badge-warning';
                                            if (app.status === 'Reviewed') badgeStyle = 'badge-users';
                                            else if (app.status === 'Interviewing') badgeStyle = 'badge-apps';
                                            else if (app.status === 'Accepted') badgeStyle = 'badge-success';
                                            else if (app.status === 'Rejected') badgeStyle = 'badge-danger';
                                        %>
                                        <span class="badge <%= badgeStyle %>">
                                            <%= app.status %>
                                        </span>
                                    </td>
                                    <td><%= String(app.applied_at).split('T')[0] %></td>
                                    <td style="text-align: right;">
                                        <div class="table-actions" style="justify-content: flex-end;">
                                            <a href="/applications/<%= app.id %>" class="action-pill action-view">İncele</a>
                                            <form action="/applications/<%= app.id %>/delete" method="POST" style="display:inline"
                                                  onsubmit="return confirm('Bu başvuruyu silmek istediğinize emin misiniz?')">
                                                <button type="submit" class="action-pill action-delete">Sil</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
