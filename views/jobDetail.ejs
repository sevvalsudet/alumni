<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= job.title %> - <%= job.company %> | Alumni Tracking System</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; background-color: #f4f6f9; color: #333; padding: 30px 20px; }
        .container { max-width: 950px; margin: 0 auto; }
        
        /* Header */
        header { text-align: center; margin-bottom: 25px; }
        h1 { color: #2c3e50; font-size: 28px; margin-bottom: 8px; }
        p.subtitle { color: #7f8c8d; font-size: 15px; }

        /* Unified Navbar */
        .nav-bar { display: flex; justify-content: center; flex-wrap: wrap; gap: 8px; margin-bottom: 25px; background: white; padding: 12px 18px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); }
        .nav-bar a { color: #555; text-decoration: none; font-size: 14px; font-weight: 600; padding: 6px 14px; border-radius: 6px; transition: all 0.2s; }
        .nav-bar a:hover { background: #f0f4f8; color: #3498db; }
        .nav-bar a.active { background: #27ae60; color: white; }

        /* Card Layout */
        .card { background: white; border-radius: 8px; padding: 25px; box-shadow: 0 4px 6px rgba(0,0,0,0.06); margin-bottom: 25px; }
        .card-header { border-bottom: 2px solid #edf2f7; padding-bottom: 15px; margin-bottom: 20px; display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 10px; }
        .job-title { font-size: 24px; color: #2c3e50; margin-bottom: 6px; }
        .job-meta { color: #64748b; font-size: 15px; }
        
        /* Badges */
        .badges { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 10px; }
        .badge { display: inline-block; padding: 4px 10px; border-radius: 12px; font-size: 12px; font-weight: 600; }
        .badge-type { background: #e8f8f0; color: #27ae60; }
        .badge-level { background: #eaf2f8; color: #2980b9; }
        .badge-salary { background: #fef5e7; color: #d35400; font-weight: 700; }

        /* Section blocks */
        .section-title { font-size: 13px; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px; margin-top: 20px; margin-bottom: 8px; }
        .content-block { background: #f8fafc; padding: 18px; border-radius: 6px; border: 1px solid #edf2f7; color: #334155; line-height: 1.6; font-size: 15px; }
        
        /* Info Grid */
        .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-top: 20px; }
        .info-box { background: #f8fafc; border: 1px solid #edf2f7; border-radius: 6px; padding: 15px; font-size: 14px; }
        .info-box strong { color: #1e293b; }

        /* Table */
        table { width: 100%; border-collapse: collapse; margin-top: 10px; }
        th, td { padding: 10px 12px; text-align: left; border-bottom: 1px solid #edf2f7; font-size: 14px; }
        th { background: #f8fafc; color: #475569; font-weight: 600; }

        /* Buttons & Actions */
        .actions { display: flex; gap: 10px; margin-top: 25px; flex-wrap: wrap; }
        .btn { padding: 10px 18px; border-radius: 6px; text-decoration: none; font-weight: 600; font-size: 14px; border: none; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; transition: opacity 0.2s; }
        .btn:hover { opacity: 0.9; }
        .btn-primary { background: #27ae60; color: white; }
        .btn-blue { background: #3498db; color: white; }
        .btn-purple { background: #8e44ad; color: white; }
        .btn-delete { background: #fee2e2; color: #dc2626; border: none; }
        .btn-back { background: #e2e8f0; color: #475569; }

        /* Quick Apply Form */
        .apply-card { background: #fdfefe; border: 2px dashed #27ae60; border-radius: 8px; padding: 22px; margin-top: 25px; }
        .apply-card h3 { color: #27ae60; font-size: 18px; margin-bottom: 12px; }
        .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
        .form-group { display: flex; flex-direction: column; }
        .form-group.full { grid-column: 1 / -1; }
        label { font-size: 13px; font-weight: 600; color: #555; margin-bottom: 4px; }
        input, select, textarea { padding: 9px 12px; border: 1px solid #dcdfe6; border-radius: 6px; font-size: 14px; font-family: inherit; }
        textarea { resize: vertical; min-height: 60px; }
    </style>
</head>
<body>
    <div class="container">
        <!-- HEADER -->
        <header>
            <h1>🎓 Alumni Tracking System</h1>
            <p class="subtitle">İş İlanı Detayı & Başvuru Yönetimi</p>
        </header>

        <!-- UNIFIED NAVBAR -->
        <div class="nav-bar">
            <a href="/">🏠 Ana Sayfa</a>
            <a href="/users">👥 Kullanıcılar</a>
            <a href="/announcements">📢 Duyurular</a>
            <a href="/jobs" class="active">💼 İş İlanları</a>
            <a href="/applications">📝 Başvurular</a>
            <a href="/api/jobs/<%= job.id %>" target="_blank">⚡ API (JSON)</a>
            <a href="/api/swagger" target="_blank">📖 Swagger</a>
        </div>

        <div class="card">
            <!-- JOB TITLE & BADGES -->
            <div class="card-header">
                <div>
                    <h2 class="job-title">💼 <%= job.title %></h2>
                    <div class="job-meta">
                        🏢 <strong><%= job.company %></strong> &bull; 📍 <%= job.location %> &bull; İlan ID: #<%= job.id %>
                    </div>
                    <div class="badges">
                        <span class="badge badge-type"><%= job.employment_type %></span>
                        <span class="badge badge-level"><%= job.experience_level %></span>
                        <% if (job.salary) { %>
                            <span class="badge badge-salary">💰 $<%= Number(job.salary).toLocaleString() %></span>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- JOB DESCRIPTION -->
            <div class="section-title">İş Tanımı ve Kapsamı</div>
            <div class="content-block">
                <%= job.description %>
            </div>

            <!-- REQUIREMENTS -->
            <% if (job.requirements) { %>
                <div class="section-title">Aranan Nitelikler & Beceriler</div>
                <div class="content-block">
                    <%= job.requirements %>
                </div>
            <% } %>

            <!-- METADATA BOX -->
            <div class="info-grid">
                <div class="info-box">
                    <strong>İlanı Paylaşan:</strong> 
                    <a href="/users/<%= job.posted_by %>" style="color:#3498db; text-decoration:none; font-weight:600;">
                        <%= job.posted_by_name || 'Üye #' + job.posted_by %>
                    </a>
                    <% if (job.posted_by_email) { %> (<%= job.posted_by_email %>)<% } %>
                </div>
                <div class="info-box">
                    <strong>Son Başvuru Tarihi:</strong> 
                    <%= job.application_deadline ? String(job.application_deadline).split('T')[0] : 'Açık / Belirtilmedi' %>
                </div>
            </div>

            <!-- ACTIONS -->
            <div class="actions">
                <a href="/jobs" class="btn btn-back">← İlanlar Listesine Dön</a>
                <a href="/jobs/<%= job.id %>/applications" class="btn btn-purple">📝 Tüm Başvuruları Gör (<%= applicants ? applicants.length : 0 %>)</a>
                <% if (job.application_url) { %>
                    <a href="<%= job.application_url %>" target="_blank" class="btn btn-primary">🚀 Dış Linkten Başvur</a>
                <% } %>
                <% if (job.contact_email) { %>
                    <a href="mailto:<%= job.contact_email %>" class="btn btn-blue">📧 İletişime Geç</a>
                <% } %>
                <form action="/jobs/<%= job.id %>/delete" method="POST" style="display:inline"
                      onsubmit="return confirm('Bu iş ilanını silmek istediğinize emin misiniz?')">
                    <button type="submit" class="btn btn-delete">🗑 İlanı Sil</button>
                </form>
            </div>
        </div>

        <!-- 🔗 M:N APPLICANTS THROUGH APPLICATIONS TABLE -->
        <div class="card">
            <h2>
                <span>👥 Bu İlana Başvuran Adaylar (<%= applicants ? applicants.length : 0 %>)</span>
                <span style="font-size: 13px; color: #8e44ad; font-weight: normal;">[M:N through Application]</span>
            </h2>

            <% if (!applicants || applicants.length === 0) { %>
                <p style="color: #888; font-size: 14px; padding: 15px 0;">Henüz bu ilana bir başvuru yapılmadı. Aşağıdaki form ile hemen başvuru yapabilirsiniz.</p>
            <% } else { %>
                <table>
                    <thead>
                        <tr>
                            <th>Başvuru ID</th>
                            <th>Aday Adı</th>
                            <th>Rol / Bölüm</th>
                            <th>Durum</th>
                            <th>Tarih</th>
                            <th>İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% applicants.forEach(app => { %>
                            <tr>
                                <td><strong>#<%= app.application_id %></strong></td>
                                <td>
                                    <a href="/users/<%= app.id %>" style="color:#2980b9; font-weight:600; text-decoration:none;">
                                        👤 <%= app.name %>
                                    </a>
                                </td>
                                <td><%= app.role %> - <%= app.department || 'N/A' %></td>
                                <td>
                                    <span class="badge badge-type" style="background:#f4ecf7; color:#8e44ad;">
                                        <%= app.application_status %>
                                    </span>
                                </td>
                                <td style="color:#888; font-size:13px;">
                                    <%= String(app.applied_at).split('T')[0] %>
                                </td>
                                <td>
                                    <a href="/applications/<%= app.application_id %>" style="color:#3498db; font-weight:600; font-size:13px; text-decoration:none;">
                                        👁 İncele
                                    </a>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            <% } %>

            <!-- QUICK APPLY FORM DIRECTLY FROM JOB DETAIL -->
            <div class="apply-card">
                <h3>🚀 Bu İlana Hızlı Başvuru Yap</h3>
                <form action="/applications" method="POST">
                    <input type="hidden" name="job_id" value="<%= job.id %>">
                    <div class="form-grid">
                        <div class="form-group">
                            <label for="user_id">Başvuran Kullanıcı Seçin *</label>
                            <select id="user_id" name="user_id" required>
                                <% users.forEach(u => { %>
                                    <option value="<%= u.id %>"><%= u.name %> (<%= u.role %> - <%= u.department || 'General' %>)</option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="resume_url">Özgeçmiş / CV Linki</label>
                            <input type="url" id="resume_url" name="resume_url" placeholder="https://example.com/cv.pdf">
                        </div>
                        <div class="form-group full">
                            <label for="cover_letter">Ön Yazı / Motivasyon Notu</label>
                            <textarea id="cover_letter" name="cover_letter" placeholder="Bu rol için motivasyonunuz ve deneyiminiz..."></textarea>
                        </div>
                        <div class="form-group full">
                            <button type="submit" class="btn btn-primary" style="width:100%;">🚀 Başvuruyu Gönder</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
</html>
