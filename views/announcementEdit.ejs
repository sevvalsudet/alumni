<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Announcement - Alumni Tracking System</title>
    <style>
        body { font-family: Arial, sans-serif; max-width: 700px; margin: 40px auto; padding: 0 20px; background: #f4f6f9; }
        .nav { margin-bottom: 20px; }
        .nav a { margin-right: 15px; color: #3498db; text-decoration: none; font-weight: bold; }
        .form-card { background: white; padding: 30px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
        h1 { color: #2c3e50; border-bottom: 3px solid #f39c12; padding-bottom: 10px; margin-top: 0; }
        .form-group { margin-bottom: 16px; }
        .form-group label { display: block; font-weight: bold; color: #555; margin-bottom: 6px; }
        .form-group input, .form-group textarea, .form-group select {
            width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 4px; box-sizing: border-box; font-size: 15px;
        }
        .form-group textarea { resize: vertical; min-height: 100px; }
        .form-row { display: flex; gap: 15px; flex-wrap: wrap; }
        .form-row .form-group { flex: 1; min-width: 180px; }
        .form-group input:focus, .form-group textarea:focus, .form-group select:focus {
            outline: none; border-color: #f39c12; box-shadow: 0 0 0 2px rgba(243,156,18,0.2);
        }
        .actions { display: flex; gap: 12px; margin-top: 20px; }
        .btn-save { background: #f39c12; color: white; border: none; padding: 11px 25px; border-radius: 4px; cursor: pointer; font-size: 15px; font-weight: bold; }
        .btn-save:hover { background: #d68910; }
        .btn-cancel { background: #95a5a6; color: white; padding: 11px 20px; border-radius: 4px; text-decoration: none; font-size: 15px; font-weight: bold; }
        .id-badge { font-size: 14px; color: #aaa; margin-left: 10px; }
    </style>
</head>
<body>
    <div class="nav">
        <a href="/">🏠 Ana Sayfa</a>
        <a href="/announcements">← Announcements</a>
        <a href="/announcements/<%= announcement.id %>">← Detail</a>
    </div>

    <div class="form-card">
        <h1>✏️ Edit Announcement <span class="id-badge">#<%= announcement.id %></span></h1>

        <form action="/announcements/<%= announcement.id %>/update" method="POST">
            <div class="form-group">
                <label for="title">Title *</label>
                <input type="text" id="title" name="title" value="<%= announcement.title %>" required>
            </div>
            <div class="form-group">
                <label for="content">Content *</label>
                <textarea id="content" name="content" required><%= announcement.content %></textarea>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label for="author">Author</label>
                    <input type="text" id="author" name="author" value="<%= announcement.author %>">
                </div>
                <div class="form-group">
                    <label for="date">Date</label>
                    <input type="date" id="date" name="date" value="<%= announcement.date %>">
                </div>
                <div class="form-group">
                    <label for="category">Category</label>
                    <select id="category" name="category">
                        <option value="General" <%= announcement.category === 'General' ? 'selected' : '' %>>General</option>
                        <option value="Event" <%= announcement.category === 'Event' ? 'selected' : '' %>>Event</option>
                        <option value="Scholarship" <%= announcement.category === 'Scholarship' ? 'selected' : '' %>>Scholarship</option>
                        <option value="Career" <%= announcement.category === 'Career' ? 'selected' : '' %>>Career</option>
                        <option value="Academic" <%= announcement.category === 'Academic' ? 'selected' : '' %>>Academic</option>
                    </select>
                </div>
            </div>
            <div class="actions">
                <button type="submit" class="btn-save">💾 Save Changes</button>
                <a href="/announcements/<%= announcement.id %>" class="btn-cancel">✖ Cancel</a>
            </div>
        </form>
    </div>
</body>
</html>
