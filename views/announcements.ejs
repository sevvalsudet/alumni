<!DOCTYPE html>
<html lang="tr">
<head>
    <%- include('partials/head', { title: 'Duyurular & Bildirimler • Alumni.io' }) %>
</head>
<body>
    <%- include('partials/navbar', { active: 'announcements' }) %>

    <main class="container">
        <div class="page-header">
            <h1>📢 Üniversite & Kariyer Duyuruları</h1>
            <p class="subtitle">Etkinlikler, burslar, akademik takvim ve mezunlar buluşması duyurularını takip edin.</p>
        </div>

        <!-- ➕ CREATE FORM -->
        <div class="card">
            <h2>
                <span>➕ Yeni Duyuru Yayınla</span>
                <span class="badge badge-announcements">CREATE</span>
            </h2>
            <form action="/announcements" method="POST">
                <div class="form-group" style="margin-bottom: 16px;">
                    <label for="title">Duyuru Başlığı *</label>
                    <input type="text" id="title" name="title" placeholder="Örn: 2026 Mezunlar Zirvesi ve Kariyer Fuarı" required>
                </div>
                <div class="form-group" style="margin-bottom: 16px;">
                    <label for="content">Duyuru İçeriği ve Detaylar *</label>
                    <textarea id="content" name="content" placeholder="Duyuru metni, katılım koşulları, tarih ve konum..." required></textarea>
                </div>
                <div class="form-grid grid-3">
                    <div class="form-group">
                        <label for="author">Yayınlayan</label>
                        <input type="text" id="author" name="author" placeholder="Admin" value="Rektörlük / Kariyer Merkezi">
                    </div>
                    <div class="form-group">
                        <label for="date">Tarih</label>
                        <input type="date" id="date" name="date">
                    </div>
                    <div class="form-group">
                        <label for="category">Kategori</label>
                        <select id="category" name="category">
                            <option value="General">Genel (General)</option>
                            <option value="Event">Etkinlik (Event)</option>
                            <option value="Scholarship">Burs (Scholarship)</option>
                            <option value="Career">Kariyer (Career)</option>
                            <option value="Academic">Akademik (Academic)</option>
                        </select>
                    </div>
                </div>
                <div style="margin-top: 20px;">
                    <button type="submit" class="btn btn-primary" style="background: var(--announcements-accent); width: 100%;">
                        <span>Duyuruyu Yayınla</span>
                        <span>→</span>
                    </button>
                </div>
            </form>
        </div>

        <!-- 📖 ANNOUNCEMENTS TABLE -->
        <div class="card">
            <h2>
                <span>📋 Yayındaki Duyurular</span>
                <span class="badge badge-announcements"><%= announcements.length %> Duyuru</span>
            </h2>

            <% if (announcements.length === 0) { %>
                <div style="text-align: center; color: var(--stone); padding: 35px 20px;">
                    📭 Henüz yayında bir duyuru bulunmuyor. İlk duyuruyu yukarıdaki formdan paylaşabilirsiniz!
                </div>
            <% } else { %>
                <div class="table-responsive">
                    <table>
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Başlık</th>
                                <th>Özet İçerik</th>
                                <th>Yayınlayan</th>
                                <th>Tarih</th>
                                <th>Kategori</th>
                                <th style="text-align: right;">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% announcements.forEach(announcement => { %>
                                <tr>
                                    <td><strong style="color: var(--ink);">#<%= announcement.id %></strong></td>
                                    <td>
                                        <div style="font-weight: 700; color: var(--ink);"><%= announcement.title %></div>
                                    </td>
                                    <td>
                                        <div style="max-width: 260px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--slate); font-size: 13.5px;">
                                            <%= announcement.content %>
                                        </div>
                                    </td>
                                    <td><%= announcement.author %></td>
                                    <td><%= announcement.date || '—' %></td>
                                    <td>
                                        <span class="badge badge-announcements">
                                            <%= announcement.category %>
                                        </span>
                                    </td>
                                    <td style="text-align: right;">
                                        <div class="table-actions" style="justify-content: flex-end;">
                                            <a href="/announcements/<%= announcement.id %>" class="action-pill action-view">Detay</a>
                                            <a href="/announcements/<%= announcement.id %>/edit" class="action-pill action-edit">Düzenle</a>
                                            <form action="/announcements/<%= announcement.id %>/delete" method="POST" style="display:inline"
                                                  onsubmit="return confirm('Bu duyuruyu silmek istediğinize emin misiniz?')">
                                                <button type="submit" class="action-pill action-delete">Sil</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
