<!DOCTYPE html>
<html lang="tr">
<head>
    <%- include('partials/head', { title: announcement.title + ' • Duyuru Detayı' }) %>
    <style>
        .announcement-box { max-width: 780px; margin: 0 auto; }
        .content-panel {
            background: var(--announcements-surface);
            border-left: 4px solid var(--announcements-accent);
            padding: 24px;
            border-radius: 0 var(--radius-md) var(--radius-md) 0;
            color: var(--ink);
            font-size: 15.5px;
            line-height: 1.7;
            white-space: pre-line;
            margin: 20px 0 25px;
        }
    </style>
</head>
<body>
    <%- include('partials/navbar', { active: 'announcements' }) %>

    <main class="container">
        <div class="announcement-box">
            <div style="margin: 20px 0 10px;">
                <a href="/announcements" style="color: var(--brand-primary); text-decoration: none; font-size: 14px; font-weight: 600;">← Duyurular Listesine Dön</a>
            </div>

            <div class="card">
                <div style="padding-bottom: 20px; border-bottom: 1px solid var(--hairline);">
                    <div style="display: flex; gap: 8px; margin-bottom: 10px; align-items: center;">
                        <span class="badge badge-announcements"><%= announcement.category %></span>
                        <span style="font-size: 13px; color: var(--stone); font-family: monospace;">ID: #<%= announcement.id %></span>
                    </div>
                    <h1 style="font-size: 26px; font-weight: 800; color: var(--ink); line-height: 1.25; margin-bottom: 8px;">
                        <%= announcement.title %>
                    </h1>
                    <div style="font-size: 14px; color: var(--slate);">
                        Yayınlayan: <strong style="color: var(--ink);"><%= announcement.author %></strong> &bull; Tarih: <%= announcement.date || '—' %>
                    </div>
                </div>

                <div class="content-panel">
                    <%= announcement.content %>
                </div>

                <div style="display: flex; gap: 10px; flex-wrap: wrap; padding-top: 16px; border-top: 1px solid var(--hairline);">
                    <a href="/announcements/<%= announcement.id %>/edit" class="btn btn-primary" style="background: var(--announcements-accent);">
                        Düzenle
                    </a>
                    <form action="/announcements/<%= announcement.id %>/delete" method="POST"
                          onsubmit="return confirm('Bu duyuruyu silmek istediğinize emin misiniz?')">
                        <button type="submit" class="btn btn-danger">Duyuruyu Sil</button>
                    </form>
                    <a href="/announcements" class="btn btn-secondary" style="margin-left: auto;">
                        Listeye Dön
                    </a>
                </div>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
