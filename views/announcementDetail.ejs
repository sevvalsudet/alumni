<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head', { title: announcement.title + ' • Notice Details' }) %>
    <style>
        .announcement-box {
            max-width: 1100px;
            margin: 0 auto;
        }
        .content-panel {
            background: var(--canvas-parchment);
            border-left: 4px solid var(--apple-blue);
            padding: 24px;
            border-radius: 0 var(--radius-md) var(--radius-md) 0;
            color: var(--ink);
            font-size: 15.5px;
            line-height: 1.7;
            white-space: pre-line;
            margin: 20px 0 25px;
        }
    </style>
</head>
<body>
    <%- include('partials/navbar', { active: 'announcements' }) %>

    <main class="container">
        <div class="announcement-box">
            <div style="margin: 20px 0 16px;">
                <a href="/announcements" class="link-chevron" style="font-weight: 600;">← Back to Notices Newsroom</a>
            </div>

            <div class="card">
                <div style="padding-bottom: 20px; border-bottom: 1px solid var(--hairline-soft);">
                    <div style="display: flex; gap: 8px; margin-bottom: 10px; align-items: center;">
                        <span class="badge badge-announcements"><%= announcement.category %></span>
                        <span style="font-size: 13px; color: var(--ink-muted); font-family: monospace;">ID: #<%= announcement.id %></span>
                    </div>
                    <h1 style="font-size: 26px; font-weight: 800; color: var(--ink); line-height: 1.25; margin-bottom: 8px; letter-spacing: -0.02em;">
                        <%= announcement.title %>
                    </h1>
                    <div style="font-size: 14px; color: var(--ink-secondary);">
                        Published by: <strong style="color: var(--ink);"><%= announcement.author %></strong> &bull; Date: <%= announcement.date || '—' %>
                    </div>
                </div>

                <div class="content-panel">
                    <%= announcement.content %>
                </div>

                <div style="display: flex; gap: 10px; flex-wrap: wrap; padding-top: 18px; border-top: 1px solid var(--hairline-soft); align-items: center;">
                    <a href="/announcements/<%= announcement.id %>/edit" class="btn btn-runway">
                        Edit Notice
                    </a>
                    <form action="/announcements/<%= announcement.id %>/delete" method="POST"
                          onsubmit="return confirm('Are you sure you want to delete this notice?')">
                        <button type="submit" class="btn btn-danger">Delete Notice</button>
                    </form>
                    <a href="/announcements" class="btn btn-secondary" style="margin-left: auto;">
                        Back to Newsroom
                    </a>
                </div>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
