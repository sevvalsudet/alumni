<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Application #<%= application.id %> - Alumni Tracking System</title>
    <style>
        body { font-family: Arial, sans-serif; max-width: 850px; margin: 40px auto; padding: 0 20px; background: #f4f6f9; }
        .nav { margin-bottom: 20px; }
        .nav a { margin-right: 15px; color: #3498db; text-decoration: none; font-weight: bold; }
        .card { background: white; padding: 30px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
        .card-header { border-bottom: 3px solid #8e44ad; padding-bottom: 15px; margin-bottom: 25px; display: flex; justify-content: space-between; align-items: flex-start; }
        h1 { color: #2c3e50; margin: 0 0 8px 0; font-size: 24px; }
        .sub-header { color: #555; font-size: 16px; }
        .badge { display: inline-block; padding: 6px 14px; border-radius: 14px; font-size: 14px; font-weight: bold; }
        .badge-pending { background: #fef9e7; color: #f39c12; border: 1px solid #f9e79f; }
        .badge-reviewed { background: #ebf5fb; color: #2980b9; border: 1px solid #aed6f1; }
        .badge-interviewing { background: #f5eef8; color: #8e44ad; border: 1px solid #d7bde2; }
        .badge-accepted { background: #eafaf1; color: #27ae60; border: 1px solid #a9dfbf; }
        .badge-rejected { background: #fdedec; color: #e74c3c; border: 1px solid #f5b7b1; }
        .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 25px; }
        .info-box { background: #fafbfc; padding: 18px; border-radius: 6px; border: 1px solid #e1e8ed; }
        .info-box h3 { margin-top: 0; color: #2c3e50; font-size: 16px; border-bottom: 2px solid #eee; padding-bottom: 8px; }
        .info-box p { margin: 8px 0; font-size: 14px; color: #555; }
        .info-box strong { color: #333; }
        .field-label { font-weight: bold; color: #777; display: block; margin-top: 20px; margin-bottom: 8px; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; }
        .field-value { color: #2c3e50; font-size: 15px; line-height: 1.6; background: #fafbfc; padding: 18px; border-radius: 6px; border: 1px solid #eee; white-space: pre-wrap; }
        .status-form-box { background: #fdfaf6; border: 1px solid #fae5d3; border-radius: 6px; padding: 18px; margin-top: 25px; }
        .status-form-box h3 { margin: 0 0 12px 0; color: #d35400; font-size: 15px; }
        .status-row { display: flex; gap: 12px; align-items: center; }
        .status-row select { padding: 8px 12px; border-radius: 4px; border: 1px solid #ddd; font-size: 14px; flex: 1; }
        .btn { padding: 9px 18px; border-radius: 5px; text-decoration: none; font-weight: bold; font-size: 14px; border: none; cursor: pointer; }
        .btn-update { background: #d35400; color: white; }
        .btn-resume { background: #27ae60; color: white; display: inline-block; margin-top: 10px; }
        .btn-delete { background: #e74c3c; color: white; }
        .btn-back { background: #95a5a6; color: white; }
        .actions { margin-top: 30px; display: flex; gap: 12px; }
    </style>
</head>
<body>
    <div class="nav">
        <a href="/">🏠 Ana Sayfa</a>
        <a href="/applications">← All Applications</a>
        <a href="/jobs/<%= application.job_id %>">💼 View Job Listing</a>
        <a href="/jobs/<%= application.job_id %>/applications">🔗 Other Candidates</a>
        <a href="/users/<%= application.user_id %>/applications">👤 Applicant's Applications</a>
    </div>

    <div class="card">
        <div class="card-header">
            <div>
                <h1>📝 Application #<%= application.id %></h1>
                <div class="sub-header">
                    Applied for <strong><%= application.job_title %></strong> at <strong><%= application.job_company %></strong>
                </div>
            </div>
            <div>
                <% 
                    let badgeClass = 'badge-pending';
                    if (application.status === 'Reviewed') badgeClass = 'badge-reviewed';
                    else if (application.status === 'Interviewing') badgeClass = 'badge-interviewing';
                    else if (application.status === 'Accepted') badgeClass = 'badge-accepted';
                    else if (application.status === 'Rejected') badgeClass = 'badge-rejected';
                %>
                <span class="badge <%= badgeClass %>"><%= application.status %></span>
            </div>
        </div>

        <div class="grid-2">
            <!-- TARGET JOB INFO -->
            <div class="info-box">
                <h3>💼 Position Details</h3>
                <p><strong>Role:</strong> <%= application.job_title %></p>
                <p><strong>Company:</strong> <%= application.job_company %></p>
                <p><strong>Location:</strong> <%= application.job_location || 'Not specified' %></p>
                <p><strong>Type:</strong> <%= application.job_employment_type || 'Full-time' %></p>
                <p><a href="/jobs/<%= application.job_id %>" style="color: #3498db; font-weight: bold;">View Full Job Listing →</a></p>
            </div>

            <!-- APPLICANT INFO -->
            <div class="info-box">
                <h3>👤 Candidate Details</h3>
                <p><strong>Name:</strong> <%= application.applicant_name %></p>
                <p><strong>Email:</strong> <%= application.applicant_email %></p>
                <p><strong>Department:</strong> <%= application.applicant_department || 'N/A' %></p>
                <% if (application.applicant_current_company) { %>
                    <p><strong>Current Employer:</strong> <%= application.applicant_current_company %></p>
                <% } %>
                <p><a href="/users/<%= application.user_id %>" style="color: #2980b9; font-weight: bold;">View Profile →</a></p>
            </div>
        </div>

        <!-- RESUME -->
        <span class="field-label">Applicant Resume / Portfolio</span>
        <% if (application.resume_url) { %>
            <div>
                <a href="<%= application.resume_url %>" target="_blank" class="btn btn-resume">📄 Open Resume / CV Document ↗</a>
                <span style="margin-left: 10px; color: #777; font-size: 13px;">(<%= application.resume_url %>)</span>
            </div>
        <% } else { %>
            <div style="color: #999; font-style: italic;">No resume link provided.</div>
        <% } %>

        <!-- COVER LETTER -->
        <span class="field-label">Cover Letter / Personal Statement</span>
        <div class="field-value"><%= application.cover_letter || 'No cover letter submitted.' %></div>

        <!-- RECRUITER STATUS UPDATE FORM -->
        <div class="status-form-box">
            <h3>⚙️ Update Application Review Status</h3>
            <form action="/applications/<%= application.id %>/status" method="POST" class="status-row">
                <select name="status">
                    <option value="Pending" <%= application.status === 'Pending' ? 'selected' : '' %>>⏳ Pending</option>
                    <option value="Reviewed" <%= application.status === 'Reviewed' ? 'selected' : '' %>>👀 Reviewed</option>
                    <option value="Interviewing" <%= application.status === 'Interviewing' ? 'selected' : '' %>>💬 Interviewing</option>
                    <option value="Accepted" <%= application.status === 'Accepted' ? 'selected' : '' %>>🎉 Accepted</option>
                    <option value="Rejected" <%= application.status === 'Rejected' ? 'selected' : '' %>>❌ Rejected</option>
                </select>
                <button type="submit" class="btn btn-update">Save Status</button>
            </form>
        </div>

        <div style="margin-top: 20px; font-size: 12px; color: #888;">
            <span>📅 Submitted on: <%= new Date(application.applied_at).toLocaleString() %></span>
            <% if (application.updated_at) { %>
                &bull; <span>Last updated: <%= new Date(application.updated_at).toLocaleString() %></span>
            <% } %>
        </div>

        <div class="actions">
            <a href="/applications" class="btn btn-back">← Back to Applications</a>
            <form action="/applications/<%= application.id %>/delete" method="POST"
                  onsubmit="return confirm('Are you sure you want to withdraw/delete this application?')">
                <button type="submit" class="btn btn-delete">🗑 Delete Application</button>
            </form>
        </div>
    </div>
</body>
</html>
