<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Başvuru #<%= application.id %> - Alumni Tracking System</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; background-color: #f4f6f9; color: #333; padding: 30px 20px; }
        .container { max-width: 950px; margin: 0 auto; }
        
        /* Header */
        header { text-align: center; margin-bottom: 25px; }
        h1 { color: #2c3e50; font-size: 28px; margin-bottom: 8px; }
        p.subtitle { color: #7f8c8d; font-size: 15px; }

        /* Unified Navbar */
        .nav-bar { display: flex; justify-content: center; flex-wrap: wrap; gap: 8px; margin-bottom: 25px; background: white; padding: 12px 18px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); }
        .nav-bar a { color: #555; text-decoration: none; font-size: 14px; font-weight: 600; padding: 6px 14px; border-radius: 6px; transition: all 0.2s; }
        .nav-bar a:hover { background: #f0f4f8; color: #8e44ad; }
        .nav-bar a.active { background: #8e44ad; color: white; }

        /* Card Layout */
        .card { background: white; border-radius: 8px; padding: 25px; box-shadow: 0 4px 6px rgba(0,0,0,0.06); margin-bottom: 25px; }
        .card-header { border-bottom: 2px solid #edf2f7; padding-bottom: 15px; margin-bottom: 20px; display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 10px; }
        .app-title { font-size: 24px; color: #2c3e50; margin-bottom: 6px; }
        .app-meta { color: #64748b; font-size: 15px; }
        
        /* Status Badges */
        .badge { display: inline-block; padding: 6px 14px; border-radius: 14px; font-size: 13px; font-weight: 600; }
        .badge-pending { background: #fef9e7; color: #d97706; }
        .badge-reviewed { background: #ebf5fb; color: #2563eb; }
        .badge-interviewing { background: #f5eef8; color: #7c3aed; }
        .badge-accepted { background: #dcfce7; color: #15803d; }
        .badge-rejected { background: #fee2e2; color: #dc2626; }

        /* Grid */
        .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px; }
        .info-box { background: #f8fafc; padding: 18px; border-radius: 6px; border: 1px solid #edf2f7; }
        .info-box h3 { margin-top: 0; color: #2c3e50; font-size: 16px; border-bottom: 2px solid #edf2f7; padding-bottom: 8px; margin-bottom: 12px; }
        .info-box p { margin: 8px 0; font-size: 14px; color: #555; }
        .info-box strong { color: #1e293b; }

        /* Section blocks */
        .section-title { font-size: 13px; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px; margin-top: 20px; margin-bottom: 8px; }
        .content-block { background: #f8fafc; padding: 18px; border-radius: 6px; border: 1px solid #edf2f7; color: #334155; line-height: 1.6; font-size: 15px; white-space: pre-wrap; }

        /* Status Form Box */
        .status-form-box { background: #fdfaf6; border: 1px solid #fae5d3; border-radius: 6px; padding: 18px; margin-top: 25px; }
        .status-form-box h3 { margin: 0 0 12px 0; color: #d35400; font-size: 15px; }
        .status-row { display: flex; gap: 12px; align-items: center; }
        .status-row select { padding: 9px 12px; border-radius: 6px; border: 1px solid #dcdfe6; font-size: 14px; flex: 1; outline: none; }
        .status-row select:focus { border-color: #d35400; }
        
        /* Buttons */
        .btn { padding: 10px 18px; border-radius: 6px; text-decoration: none; font-weight: 600; font-size: 14px; border: none; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; transition: opacity 0.2s; }
        .btn:hover { opacity: 0.9; }
        .btn-update { background: #d35400; color: white; }
        .btn-resume { background: #27ae60; color: white; margin-top: 6px; }
        .btn-delete { background: #fee2e2; color: #dc2626; }
        .btn-back { background: #e2e8f0; color: #475569; }
        .actions { margin-top: 25px; display: flex; gap: 10px; flex-wrap: wrap; }

        @media (max-width: 768px) {
            .grid-2 { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- HEADER -->
        <header>
            <h1>🎓 Alumni Tracking System</h1>
            <p class="subtitle">Başvuru İnceleme & Durum Güncelleme</p>
        </header>

        <!-- UNIFIED NAVBAR -->
        <div class="nav-bar">
            <a href="/">🏠 Ana Sayfa</a>
            <a href="/users">👥 Kullanıcılar</a>
            <a href="/announcements">📢 Duyurular</a>
            <a href="/jobs">💼 İş İlanları</a>
            <a href="/applications" class="active">📝 Başvurular</a>
            <a href="/api/applications/<%= application.id %>" target="_blank">⚡ API (JSON)</a>
            <a href="/api/swagger" target="_blank">📖 Swagger</a>
        </div>

        <div class="card">
            <!-- HEADER INFO -->
            <div class="card-header">
                <div>
                    <h2 class="app-title">📝 Başvuru #<%= application.id %></h2>
                    <div class="app-meta">
                        Pozisyon: <strong><%= application.job_title %></strong> &bull; Şirket: <strong><%= application.job_company %></strong>
                    </div>
                </div>
                <div>
                    <% 
                        let badgeClass = 'badge-pending';
                        if (application.status === 'Reviewed') badgeClass = 'badge-reviewed';
                        else if (application.status === 'Interviewing') badgeClass = 'badge-interviewing';
                        else if (application.status === 'Accepted') badgeClass = 'badge-accepted';
                        else if (application.status === 'Rejected') badgeClass = 'badge-rejected';
                    %>
                    <span class="badge <%= badgeClass %>"><%= application.status %></span>
                </div>
            </div>

            <!-- GRID 2: JOB & APPLICANT DETAILS -->
            <div class="grid-2">
                <div class="info-box">
                    <h3>💼 Başvurulan Pozisyon</h3>
                    <p><strong>Pozisyon:</strong> <%= application.job_title %></p>
                    <p><strong>Şirket:</strong> <%= application.job_company %></p>
                    <p><strong>Konum:</strong> <%= application.job_location || 'Belirtilmedi' %></p>
                    <p><strong>Çalışma Şekli:</strong> <%= application.job_employment_type || 'Full-time' %></p>
                    <p style="margin-top:12px;">
                        <a href="/jobs/<%= application.job_id %>" style="color: #3498db; font-weight: 600; text-decoration: none;">
                            💼 İlan Detayına Git →
                        </a>
                    </p>
                </div>

                <div class="info-box">
                    <h3>👤 Başvuran Aday</h3>
                    <p><strong>Ad Soyad:</strong> <%= application.applicant_name %></p>
                    <p><strong>E-posta:</strong> <%= application.applicant_email %></p>
                    <p><strong>Bölüm:</strong> <%= application.applicant_department || 'N/A' %></p>
                    <% if (application.applicant_current_company) { %>
                        <p><strong>Mevcut Şirket:</strong> <%= application.applicant_current_company %></p>
                    <% } %>
                    <p style="margin-top:12px;">
                        <a href="/users/<%= application.user_id %>" style="color: #2980b9; font-weight: 600; text-decoration: none;">
                            👤 Profil Sayfasına Git →
                        </a>
                    </p>
                </div>
            </div>

            <!-- RESUME / CV -->
            <div class="section-title">Özgeçmiş / Portfolyo</div>
            <% if (application.resume_url) { %>
                <div>
                    <a href="<%= application.resume_url %>" target="_blank" class="btn btn-resume">
                        📄 CV / Portfolyoyu Görüntüle ↗
                    </a>
                    <span style="margin-left: 10px; color: #777; font-size: 13px;">(<%= application.resume_url %>)</span>
                </div>
            <% } else { %>
                <div style="color: #999; font-style: italic; font-size: 14px;">Özgeçmiş linki belirtilmemiş.</div>
            <% } %>

            <!-- COVER LETTER -->
            <div class="section-title">Ön Yazı / Motivasyon Notu</div>
            <div class="content-block"><%= application.cover_letter || 'Ön yazı girilmemiş.' %></div>

            <!-- STATUS UPDATE FORM -->
            <div class="status-form-box">
                <h3>⚙️ Başvuru Değerlendirme Durumunu Güncelle</h3>
                <form action="/applications/<%= application.id %>/status" method="POST" class="status-row">
                    <select name="status">
                        <option value="Pending" <%= application.status === 'Pending' ? 'selected' : '' %>>⏳ Beklemede (Pending)</option>
                        <option value="Reviewed" <%= application.status === 'Reviewed' ? 'selected' : '' %>>👀 İncelendi (Reviewed)</option>
                        <option value="Interviewing" <%= application.status === 'Interviewing' ? 'selected' : '' %>>💬 Mülakat Aşamasında (Interviewing)</option>
                        <option value="Accepted" <%= application.status === 'Accepted' ? 'selected' : '' %>>🎉 Kabul Edildi (Accepted)</option>
                        <option value="Rejected" <%= application.status === 'Rejected' ? 'selected' : '' %>>❌ Reddedildi (Rejected)</option>
                    </select>
                    <button type="submit" class="btn btn-update">Kaydet</button>
                </form>
            </div>

            <div style="margin-top: 18px; font-size: 13px; color: #888;">
                <span>📅 Başvuru Tarihi: <%= new Date(application.applied_at).toLocaleString() %></span>
                <% if (application.updated_at) { %>
                    &bull; <span>Son Güncelleme: <%= new Date(application.updated_at).toLocaleString() %></span>
                <% } %>
            </div>

            <!-- ACTIONS -->
            <div class="actions">
                <a href="/applications" class="btn btn-back">← Başvurular Listesine Dön</a>
                <a href="/jobs/<%= application.job_id %>/applications" class="btn btn-back" style="background:#f4ecf7; color:#8e44ad;">👥 Bu İlandaki Diğer Adaylar</a>
                <form action="/applications/<%= application.id %>/delete" method="POST"
                      onsubmit="return confirm('Bu başvuruyu silmek istediğinize emin misiniz?')">
                    <button type="submit" class="btn btn-delete">🗑 Başvuruyu Sil</button>
                </form>
            </div>
        </div>
    </div>
</body>
</html>
